<?xml version="1.0" encoding="utf-8" ?>
<!-- Settings (C10, serverless): grouped GlassCards — PLAN (local entitlement + Restore purchases) ·
     UNITS · PRIVACY (local export / local delete) · ABOUT + licenses · DEVELOPER (DEBUG-only demo
     mode). Reference adoption of the shared foundation: TrimixPage base (screenIn entrance),
     PageHeader with ShowBack (this pushed page previously had NO back affordance), AppIcon glyphs,
     and width-constrained captions (the plan caption previously overflowed an unconstrained
     HorizontalStackLayout). -->
<controls:TrimixPage
    x:Class="Trimix.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Trimix.App.Controls"
    xmlns:vm="clr-namespace:Trimix.Core.ViewModels;assembly=Trimix.Core"
    x:DataType="vm:SettingsViewModel"
    Title="Settings">

    <!-- Header FIXED outside the scroll (matches every other page — the ← back affordance must
         never scroll away); the cards scroll beneath it. -->
    <Grid RowDefinitions="Auto,*">

        <!-- Shared header: Settings is a pushed page, so it carries the ← back affordance. -->
        <controls:PageHeader Grid.Row="0" Margin="24,8,24,0" Title="Settings" ShowBack="True" />

    <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="{StaticResource PageContentPadding}" Spacing="{StaticResource SectionSpacing}">

            <!-- Plan / entitlement (on-device) -->
            <Border Style="{StaticResource GlassCard}">
                <VerticalStackLayout Spacing="{StaticResource CardSpacing}">
                    <Label Style="{StaticResource MonoLabel}" Text="PLAN" SemanticProperties.HeadingLevel="Level2" />
                    <!-- Grid (not HorizontalStackLayout): the caption column is width-bounded so the
                         text wraps instead of clipping off-screen. -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border Grid.Column="0" Style="{StaticResource BadgeMint}" VerticalOptions="Center">
                            <Label Style="{StaticResource BadgeTextMint}" Text="{Binding EntitlementLabel}" />
                        </Border>
                        <Label
                            Grid.Column="1"
                            Style="{StaticResource Caption13}"
                            VerticalOptions="Center"
                            LineBreakMode="WordWrap"
                            Text="One-time purchase · restorable through your app store." />
                    </Grid>
                    <Button
                        Style="{StaticResource SecondaryButton}"
                        Text="Restore purchases"
                        Command="{Binding RestorePurchasesCommand}"
                        SemanticProperties.Description="Restore purchases"
                        SemanticProperties.Hint="Recovers a previous Pro or Lifetime purchase from your app store" />
                </VerticalStackLayout>
            </Border>

            <!-- Units -->
            <Border Style="{StaticResource GlassCard}">
                <VerticalStackLayout Spacing="{StaticResource CardSpacing}">
                    <Label Style="{StaticResource MonoLabel}" Text="UNITS" SemanticProperties.HeadingLevel="Level2" Margin="0,0,0,6" />
                    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="44">
                        <Label Grid.Column="0" Style="{StaticResource Body15}" Text="Depth" VerticalOptions="Center" />
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Text="{Binding DepthUnit, Converter={StaticResource DepthUnitLabel}}"
                            Command="{Binding ToggleDepthUnitCommand}"
                            SemanticProperties.Description="{Binding DepthUnit, Converter={StaticResource DepthUnitLabel}, StringFormat='Depth unit: {0}'}"
                            SemanticProperties.Hint="Switches between metres and feet" />
                    </Grid>
                    <BoxView Margin="0,4" />
                    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="44">
                        <Label Grid.Column="0" Style="{StaticResource Body15}" Text="Temperature" VerticalOptions="Center" />
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Text="{Binding TempUnit, Converter={StaticResource TempUnitLabel}}"
                            Command="{Binding ToggleTempUnitCommand}"
                            SemanticProperties.Description="{Binding TempUnit, Converter={StaticResource TempUnitLabel}, StringFormat='Temperature unit: {0}'}"
                            SemanticProperties.Hint="Switches between Celsius and Fahrenheit" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Privacy -->
            <Border Style="{StaticResource GlassCard}">
                <VerticalStackLayout Spacing="{StaticResource CardSpacing}">
                    <HorizontalStackLayout Spacing="6">
                        <controls:AppIcon Icon="lock" Size="13" VerticalOptions="Center" />
                        <Label Style="{StaticResource MonoLabel}" Text="PRIVACY" VerticalOptions="Center" SemanticProperties.HeadingLevel="Level2" />
                    </HorizontalStackLayout>
                    <Label
                        Style="{StaticResource Caption13}"
                        LineBreakMode="WordWrap"
                        Text="Everything lives on this device — there is no account and no server copy. Export gives you your dives as JSON; delete wipes this device, including provider links." />
                    <Button
                        Style="{StaticResource SecondaryButton}"
                        Text="Export my data"
                        Clicked="OnExportClicked"
                        SemanticProperties.Description="Export my data"
                        SemanticProperties.Hint="Creates a JSON export of your dives and opens the share sheet" />
                    <Button
                        Style="{StaticResource DestructiveButton}"
                        Text="Delete my data"
                        Command="{Binding DeleteMyDataCommand}"
                        SemanticProperties.Description="Delete my data"
                        SemanticProperties.Hint="Removes all dives and provider links from this device; asks for confirmation first" />
                    <Button
                        Style="{StaticResource DestructiveButton}"
                        Text="Reset app"
                        Command="{Binding ResetAppCommand}"
                        SemanticProperties.Description="Reset app"
                        SemanticProperties.Hint="Factory reset — erases all dives, links and settings and restarts onboarding; asks for confirmation first" />
                </VerticalStackLayout>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource GlassCard}">
                <VerticalStackLayout Spacing="{StaticResource CardSpacing}">
                    <Label Style="{StaticResource MonoLabel}" Text="ABOUT" SemanticProperties.HeadingLevel="Level2" />
                    <Label Style="{StaticResource Body15}" LineBreakMode="WordWrap" Text="{Binding AboutText}" />
                    <Label Style="{StaticResource Caption13}" LineBreakMode="WordWrap" Text="We log dives. We never compute decompression." />
                    <Button
                        Style="{StaticResource SecondaryButton}"
                        Text="Replay onboarding"
                        Command="{Binding ReplayOnboardingCommand}"
                        SemanticProperties.Description="Replay onboarding"
                        SemanticProperties.Hint="Runs the intro again — your dives and links stay put; handy for showing a friend" />
                    <Button
                        Style="{StaticResource SecondaryButton}"
                        Text="Open-source licenses"
                        Clicked="OnLicensesClicked"
                        SemanticProperties.Description="Open-source licenses"
                        SemanticProperties.Hint="Lists the open-source software this app is built with" />
                </VerticalStackLayout>
            </Border>

            <!-- Developer (DEBUG-only: IsDeveloperVisible is compile-time false in Release builds,
                 so this card can never render in a shipped binary). -->
            <Border Style="{StaticResource GlassCard}" IsVisible="{Binding IsDeveloperVisible}">
                <VerticalStackLayout Spacing="{StaticResource CardSpacing}">
                    <HorizontalStackLayout Spacing="6">
                        <controls:AppIcon Icon="warning" Size="13" Color="{StaticResource Warn}" VerticalOptions="Center" />
                        <Label Style="{StaticResource MonoLabel}" Text="DEVELOPER" VerticalOptions="Center" SemanticProperties.HeadingLevel="Level2" />
                    </HorizontalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" MinimumHeightRequest="44">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Style="{StaticResource Body15}" Text="Demo mode" />
                            <Label
                                Style="{StaticResource Caption13}"
                                LineBreakMode="WordWrap"
                                Text="Seeded demo providers with instant sign-in — walk connect → sync → paywall with zero vendor traffic." />
                        </VerticalStackLayout>
                        <Switch
                            Grid.Column="1"
                            IsToggled="{Binding DemoMode}"
                            VerticalOptions="Center"
                            SemanticProperties.Description="Demo mode"
                            SemanticProperties.Hint="Swaps the provider list for seeded demo providers" />
                    </Grid>
                    <Button
                        Style="{StaticResource SecondaryButton}"
                        Text="Reset demo data"
                        Command="{Binding ResetDemoDataCommand}"
                        SemanticProperties.Description="Reset demo data"
                        SemanticProperties.Hint="Removes imported demo dives and unlinks the demo providers" />
                </VerticalStackLayout>
            </Border>

            <!-- Bottom spacer so the last card scrolls clear of / under the floating iOS tab bar. -->
            <BoxView Color="Transparent" HeightRequest="{StaticResource TabScrollBottomInset}" />
        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</controls:TrimixPage>
