<?xml version="1.0" encoding="utf-8" ?>
<!-- Import flow (PRD Flow B; design doc): permission rationale → scanning (animated ping rings,
     reduced-motion aware) → device list with vendor badge → progress → results. The free-cap
     purchase moment (paywall_shown trigger=ble_import_cap) fires from the Core VM.
     S5 "Connect" restyle: pushed route with a ghost mint back row (→ DoneCommand), a centered
     sonar-ring cluster (PingRingsView + mint disc + device glyph), and a "FOUND NEARBY" device list. -->
<ContentPage
    x:Class="Trimix.App.Pages.ImportPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Trimix.Core.ViewModels;assembly=Trimix.Core"
    xmlns:abs="clr-namespace:Trimix.Core.Abstractions;assembly=Trimix.Core"
    xmlns:contracts="clr-namespace:Trimix.Contracts;assembly=Trimix.Contracts"
    xmlns:controls="clr-namespace:Trimix.App.Controls"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    x:DataType="vm:ImportViewModel"
    Title="Import">

    <Grid RowDefinitions="Auto,*">

        <!-- Ghost mint back row (pushed route). Uses the existing DoneCommand (GoBackAsync). -->
        <Button
            Grid.Row="0"
            Style="{StaticResource BackButton}"
            Text="←  Import"
            HorizontalOptions="Start"
            Margin="10,8,0,0"
            Command="{Binding DoneCommand}"
            SemanticProperties.Description="Back"
            SemanticProperties.Hint="Returns to the logbook" />

        <Grid Grid.Row="1">

            <!-- 1 · Permission rationale pane (just-in-time, before the OS prompt). -->
            <Grid
                RowDefinitions="*,Auto" Padding="{StaticResource PageContentPadding}"
                IsVisible="{Binding Step, Converter={StaticResource EnumEquals}, ConverterParameter=Rationale}">
                <VerticalStackLayout Grid.Row="0" Spacing="{StaticResource SectionSpacing}" VerticalOptions="Center">
                    <!-- Sonar-ring cluster: animated ping rings + filled mint disc + device glyph. -->
                    <Grid HorizontalOptions="Center" WidthRequest="176" HeightRequest="176">
                        <controls:PingRingsView HeightRequest="176" WidthRequest="176" HorizontalOptions="Center" VerticalOptions="Center" />
                        <shapes:Ellipse
                            Fill="{AppThemeBinding Light={StaticResource LightSonar}, Dark={StaticResource Sonar}}"
                            WidthRequest="78" HeightRequest="78"
                            HorizontalOptions="Center" VerticalOptions="Center" />
                        <Label Text="⌚" FontSize="34" TextColor="{StaticResource Abyss}"
                               HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
                    </Grid>
                    <Label
                        Style="{StaticResource Title24}"
                        Text="Import from your dive computer"
                        HorizontalTextAlignment="Center"
                        SemanticProperties.HeadingLevel="Level1" />
                    <Label
                        Style="{StaticResource Body15}"
                        TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource TextSecondary}}"
                        HorizontalTextAlignment="Center"
                        Text="Trimix uses Bluetooth only while importing — to find your wrist computer and read its dive log. Nothing runs in the background, and Bluetooth is never used for location." />
                    <!-- Per-session cap number sourced from Trimix.Contracts.FreeTier (never a hardcoded "3"),
                         so the stated limit always matches what the import actually enforces. -->
                    <Label
                        Style="{StaticResource Caption13}"
                        HorizontalTextAlignment="Center"
                        Text="{Binding Source={x:Static contracts:FreeTier.FreeImportDivesPerSession}, StringFormat='Free imports the last {0} dives per session. Pro and Lifetime import everything.'}" />
                </VerticalStackLayout>
                <Button
                    Grid.Row="1"
                    Text="Connect my dive computer"
                    Command="{Binding RequestPermissionAndScanCommand}"
                    SemanticProperties.Description="Connect my dive computer"
                    SemanticProperties.Hint="Asks for Bluetooth permission, then scans for nearby dive computers" />
            </Grid>

            <!-- 2 · Permission denied. -->
            <VerticalStackLayout
                Padding="{StaticResource PageContentPadding}" Spacing="{StaticResource SectionSpacing}" VerticalOptions="Center"
                IsVisible="{Binding Step, Converter={StaticResource EnumEquals}, ConverterParameter=PermissionDenied}">
                <Label
                    Style="{StaticResource MonoLabelMint}"
                    Text="Bluetooth needed"
                    HorizontalTextAlignment="Center" />
                <Label
                    Style="{StaticResource Title24}"
                    Text="Bluetooth permission needed"
                    HorizontalTextAlignment="Center"
                    SemanticProperties.HeadingLevel="Level1" />
                <Label
                    Style="{StaticResource Body15}"
                    TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource TextSecondary}}"
                    HorizontalTextAlignment="Center"
                    Text="Without Bluetooth permission Trimix cannot see your dive computer. You can grant it in the system settings, or try again." />
                <Button
                    Text="Open app settings"
                    Clicked="OnOpenSettingsClicked"
                    Margin="0,8,0,0"
                    SemanticProperties.Description="Open app settings"
                    SemanticProperties.Hint="Opens the system settings for Trimix to grant Bluetooth permission" />
                <Button
                    Style="{StaticResource SecondaryButton}"
                    Text="Try again"
                    Command="{Binding RequestPermissionAndScanCommand}"
                    SemanticProperties.Description="Try again"
                    SemanticProperties.Hint="Asks for Bluetooth permission again" />
            </VerticalStackLayout>

            <!-- 3 · Scanning: sonar-ring cluster + streaming device list ("FOUND NEARBY") w/ vendor badge. -->
            <Grid
                RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="{StaticResource PageContentPadding}" RowSpacing="{StaticResource SectionSpacing}"
                IsVisible="{Binding Step, Converter={StaticResource EnumEquals}, ConverterParameter=Scanning}">
                <Grid Grid.Row="0" HorizontalOptions="Center" WidthRequest="176" HeightRequest="176">
                    <controls:PingRingsView HeightRequest="176" WidthRequest="176" HorizontalOptions="Center" VerticalOptions="Center" />
                    <shapes:Ellipse
                        Fill="{AppThemeBinding Light={StaticResource LightSonar}, Dark={StaticResource Sonar}}"
                        WidthRequest="78" HeightRequest="78"
                        HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label Text="⌚" FontSize="34" TextColor="{StaticResource Abyss}"
                           HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
                </Grid>
                <Label
                    Grid.Row="1"
                    Style="{StaticResource Heading18}"
                    HorizontalTextAlignment="Center"
                    Text="Scanning for dive computers…"
                    SemanticProperties.HeadingLevel="Level1"
                    SemanticProperties.Description="Scanning for dive computers. Discovered devices appear below." />
                <Label
                    Grid.Row="2"
                    Style="{StaticResource Body15}"
                    TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource TextSecondary}}"
                    HorizontalTextAlignment="Center"
                    Text="Trimix uses Bluetooth to read dives straight off your computer. Parsing happens on-device — nothing leaves your phone." />
                <Label
                    Grid.Row="3"
                    Style="{StaticResource MonoLabel}"
                    Text="Found nearby" />
                <CollectionView Grid.Row="4" ItemsSource="{Binding Devices}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="abs:DiscoveredComputer">
                            <Border
                                Style="{StaticResource GlassCard}"
                                Margin="0,6"
                                SemanticProperties.Description="{Binding Model}"
                                SemanticProperties.Hint="Connects and imports dives from this computer">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding ImportFromCommand, Source={RelativeSource AncestorType={x:Type vm:ImportViewModel}}, x:DataType=vm:ImportViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="44" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="{StaticResource TightSpacing}" VerticalOptions="Center">
                                        <Label Style="{StaticResource Heading18}" Text="{Binding Model}" />
                                        <HorizontalStackLayout Spacing="8">
                                            <Border Style="{StaticResource BadgeMint}">
                                                <Label Style="{StaticResource BadgeTextMint}" Text="{Binding Vendor}" />
                                            </Border>
                                            <Label Style="{StaticResource Caption13}" Text="{Binding Id}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Style="{StaticResource MonoLabelMint}" Text="Connect" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label
                            Style="{StaticResource Caption13}"
                            HorizontalTextAlignment="Center"
                            Text="Hold your dive computer close to the phone and make sure Bluetooth is on." />
                    </CollectionView.EmptyView>
                </CollectionView>
            </Grid>

            <!-- 4 · Importing progress. -->
            <VerticalStackLayout
                Padding="{StaticResource PageContentPadding}" Spacing="{StaticResource SectionSpacing}" VerticalOptions="Center"
                IsVisible="{Binding Step, Converter={StaticResource EnumEquals}, ConverterParameter=Importing}">
                <Label Style="{StaticResource MonoLabel}" Text="Importing" HorizontalTextAlignment="Center" />
                <ActivityIndicator IsRunning="True" HorizontalOptions="Center" SemanticProperties.Description="Import in progress" />
                <Label
                    Style="{StaticResource Heading18}"
                    HorizontalTextAlignment="Center"
                    Text="{Binding ProgressStage}"
                    SemanticProperties.HeadingLevel="Level1" />
                <ProgressBar SemanticProperties.Description="Import progress">
                    <ProgressBar.Progress>
                        <MultiBinding Converter="{StaticResource ProgressFraction}">
                            <Binding Path="ProgressDone" />
                            <Binding Path="ProgressTotal" />
                        </MultiBinding>
                    </ProgressBar.Progress>
                </ProgressBar>
                <Label Style="{StaticResource Caption13}" HorizontalTextAlignment="Center" IsVisible="{Binding ProgressTotal, Converter={StaticResource IntGreaterThanZero}}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding ProgressDone}" />
                            <Span Text=" of " />
                            <Span Text="{Binding ProgressTotal}" />
                            <Span Text=" dives" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>

            <!-- 5 · Results (the cap-hit purchase moment opens the paywall from the VM). -->
            <ScrollView IsVisible="{Binding Step, Converter={StaticResource EnumEquals}, ConverterParameter=Results}">
                <VerticalStackLayout Padding="{StaticResource PageContentPadding}" Spacing="{StaticResource SectionSpacing}">
                    <!-- Mint success disc with Abyss checkmark. -->
                    <Grid HorizontalOptions="Center" WidthRequest="76" HeightRequest="76" Margin="0,8,0,0">
                        <shapes:Ellipse
                            Fill="{AppThemeBinding Light={StaticResource LightSignal}, Dark={StaticResource Signal}}"
                            WidthRequest="76" HeightRequest="76"
                            HorizontalOptions="Center" VerticalOptions="Center" />
                        <Label Text="✓" FontSize="36" FontFamily="{StaticResource FontDisplay}"
                               TextColor="{StaticResource Abyss}"
                               HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
                    </Grid>
                    <Label
                        Style="{StaticResource Title24}"
                        Text="Import complete"
                        HorizontalTextAlignment="Center"
                        SemanticProperties.HeadingLevel="Level1" />
                    <Border Style="{StaticResource GlassCard}">
                        <VerticalStackLayout Spacing="{StaticResource CardSpacing}">
                            <HorizontalStackLayout Spacing="3" HorizontalOptions="Center" SemanticProperties.Description="{Binding ImportedCount, StringFormat='{0} dives imported'}">
                                <Label Style="{StaticResource StatNumeralHero}" StyleClass="tnum" Text="{Binding ImportedCount}" />
                                <Label Style="{StaticResource UnitSuffix}" FontSize="22" Text="imported" VerticalOptions="End" Margin="0,0,0,6" />
                            </HorizontalStackLayout>
                            <Label
                                Style="{StaticResource Caption13}"
                                HorizontalTextAlignment="Center"
                                Text="{Binding FetchedCount, StringFormat='{0} dives found on the computer.'}" />
                            <Label
                                Style="{StaticResource Caption13}"
                                HorizontalTextAlignment="Center"
                                IsVisible="{Binding SiteMatched}"
                                Text="✓ Dive sites auto-matched from the shared database." />
                            <Label
                                Style="{StaticResource Caption13}"
                                HorizontalTextAlignment="Center"
                                IsVisible="{Binding SiteMatched, Converter={StaticResource InverseBool}}"
                                Text="No nearby site matched — you can attach one from the dive's detail page." />
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" IsVisible="{Binding CapReached}">
                        <Label Style="{StaticResource Body15}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="⚠ " TextColor="{AppThemeBinding Light={StaticResource LightWarn}, Dark={StaticResource Warn}}" />
                                    <Span Text="Free import limit reached — the remaining dives are still on your computer. Pro or Lifetime imports everything." />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Border>
                    <Button
                        Text="Done"
                        Command="{Binding DoneCommand}"
                        SemanticProperties.Description="Done"
                        SemanticProperties.Hint="Returns to the logbook" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
