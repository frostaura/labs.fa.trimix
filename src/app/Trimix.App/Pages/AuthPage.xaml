<?xml version="1.0" encoding="utf-8" ?>
<!-- Account step (prototype S3): biometric-only LOCAL unlock. "Yours, on this phone." — no cloud,
     no servers, no passkeys, no email. The glowing biometric ring drives IBiometricUnlock (iOS
     LocalAuthentication / Android BiometricPrompt; dev fallback succeeds on emulators); success
     lands on the logbook with the "Signed in on-device" toast. -->
<ContentPage
    x:Class="Trimix.App.Pages.AuthPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Trimix.Core.ViewModels;assembly=Trimix.Core"
    x:DataType="vm:AuthViewModel"
    Shell.PresentationMode="ModalAnimated"
    Title="Your logbook">

    <Grid RowDefinitions="Auto,*">

        <!-- Ghost mint back (CloseCommand) -->
        <Button
            Grid.Row="0"
            Style="{StaticResource BackButton}"
            Text="← Back"
            Command="{Binding CloseCommand}"
            Margin="10,8,0,0"
            SemanticProperties.Description="Back"
            SemanticProperties.Hint="Returns to the previous screen" />

        <VerticalStackLayout Grid.Row="1" Padding="24,0" Spacing="{StaticResource SectionSpacing}" VerticalOptions="Center">

            <Label
                Style="{StaticResource MonoLabel}"
                Text="ON-DEVICE" />
            <Label
                Style="{StaticResource Title24}"
                Text="Yours, on&#10;this phone."
                SemanticProperties.HeadingLevel="Level1" />
            <Label
                Style="{StaticResource Body15}"
                TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource TextSecondary}}"
                Text="No cloud, no servers. Your phone talks to your providers directly — your logbook and links never leave this device." />

            <!-- Biometric ring button: glowing mint ring + glyph; label swaps to "Authenticating…". -->
            <VerticalStackLayout Spacing="16" Margin="0,20,0,0" HorizontalOptions="Center">
                <Grid
                    WidthRequest="120"
                    HeightRequest="120"
                    HorizontalOptions="Center"
                    SemanticProperties.Description="{Binding AuthLabel}"
                    SemanticProperties.Hint="Unlocks your logbook with Face ID, Touch ID or your device lock">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AuthenticateCommand}" />
                    </Grid.GestureRecognizers>

                    <!-- Outer glow ring (brightens while authenticating) -->
                    <Ellipse
                        WidthRequest="120" HeightRequest="120"
                        Fill="Transparent" StrokeThickness="1.5" Opacity="0.25"
                        Stroke="{AppThemeBinding Light={StaticResource LightSonarBrush}, Dark={StaticResource SonarBrush}}"
                        HorizontalOptions="Center" VerticalOptions="Center">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding IsAuthenticating}" Value="True">
                                <Setter Property="Opacity" Value="0.7" />
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <!-- The ring button proper -->
                    <Border
                        WidthRequest="84" HeightRequest="84"
                        StrokeShape="RoundRectangle 42"
                        Stroke="{AppThemeBinding Light={StaticResource LightSonar}, Dark={StaticResource Sonar}}"
                        StrokeThickness="1.5"
                        Background="{AppThemeBinding Light={StaticResource LightSurfaceRaisedBrush}, Dark={StaticResource SurfaceRaisedBrush}}"
                        HorizontalOptions="Center" VerticalOptions="Center">
                        <Grid>
                            <!-- Fingerprint-ish glyph: concentric mint arcs -->
                            <Ellipse WidthRequest="40" HeightRequest="40" Fill="Transparent" StrokeThickness="2" Opacity="0.9"
                                     Stroke="{AppThemeBinding Light={StaticResource LightSonarBrush}, Dark={StaticResource SonarBrush}}"
                                     HorizontalOptions="Center" VerticalOptions="Center" />
                            <Ellipse WidthRequest="24" HeightRequest="24" Fill="Transparent" StrokeThickness="2" Opacity="0.7"
                                     Stroke="{AppThemeBinding Light={StaticResource LightSonarBrush}, Dark={StaticResource SonarBrush}}"
                                     HorizontalOptions="Center" VerticalOptions="Center" />
                            <Ellipse WidthRequest="8" HeightRequest="8"
                                     Fill="{AppThemeBinding Light={StaticResource LightSonarBrush}, Dark={StaticResource SonarBrush}}"
                                     HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </Grid>

                <Label
                    Style="{StaticResource Heading18}"
                    Text="{Binding AuthLabel}"
                    HorizontalTextAlignment="Center"
                    AutomationProperties.IsInAccessibleTree="False" />
                <ActivityIndicator
                    IsRunning="{Binding IsAuthenticating}"
                    IsVisible="{Binding IsAuthenticating}"
                    HorizontalOptions="Center"
                    SemanticProperties.Description="Authenticating" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
