<?xml version="1.0" encoding="utf-8" ?>
<!-- Logbook home (design "Logbook"): shared PageHeader ("Logbook" + the sonar sync button as the
     right action) · running-stats strip as instrument numerals (mint DIVES + white MAX/BOTTOM) ·
     dive rows with the rowIn stagger · free-tier cap meter near the cap (paywall_shown
     trigger=logbook_cap via the VM) · empty state with the mint trend glyph · the `+` FAB. The two
     bottom sheets (add menu + streaming sync) are BottomSheet controls, LAST children of the root
     grid so the scrim covers the window and the sheet reaches the bottom edge; the Shell tab bar is
     left in place (the sheet slides up over it — toggling it bounced the content). -->
<controls:TrimixPage
    x:Class="Trimix.App.Pages.LogbookPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Trimix.Core.ViewModels;assembly=Trimix.Core"
    xmlns:contracts="clr-namespace:Trimix.Contracts;assembly=Trimix.Contracts"
    xmlns:stats="clr-namespace:Trimix.Core.Stats;assembly=Trimix.Core"
    xmlns:controls="clr-namespace:Trimix.App.Controls"
    x:DataType="vm:LogbookViewModel"
    Title="Logbook">

    <!-- Outer grid overlays the `+` FAB and the two bottom sheets on the page. -->
    <Grid>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Shared header: title only. The sonar "Sync now" button was removed from every page's
             top-right — the add sheet's "Sync now" row is the single entry point now. -->
        <controls:PageHeader Grid.Row="0" Margin="24,8,24,0" Title="Logbook" />


        <!-- Loading skeleton: mirrors the stat strip + four dive rows so the page keeps its shape while the
             store is read. Replaces the old behaviour of rendering "No dives yet" and swapping in real dives. -->
        <controls:SkeletonPanel Grid.Row="1" Grid.RowSpan="3" Margin="24,4" IsVisible="{Binding IsLoadingSkeletonVisible}">
            <VerticalStackLayout Spacing="{StaticResource SectionSpacing}" VerticalOptions="Start">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="7">
                    <Border Grid.Column="0" Style="{StaticResource GlassCard}" HeightRequest="72" />
                    <Border Grid.Column="1" Style="{StaticResource GlassCard}" HeightRequest="72" />
                    <Border Grid.Column="2" Style="{StaticResource GlassCard}" HeightRequest="72" />
                </Grid>
                <VerticalStackLayout Spacing="26">
                    <Grid ColumnDefinitions="24,*,64" ColumnSpacing="13">
                        <BoxView Grid.Column="0" HeightRequest="12" CornerRadius="3" Color="{StaticResource SurfaceRaised}" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <BoxView HeightRequest="13" WidthRequest="120" CornerRadius="3" Color="{StaticResource SurfaceRaised}" HorizontalOptions="Start" />
                            <BoxView HeightRequest="9" WidthRequest="80" CornerRadius="3" Color="{StaticResource SurfaceRaised}" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                        <BoxView Grid.Column="2" HeightRequest="12" CornerRadius="3" Color="{StaticResource SurfaceRaised}" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="24,*,64" ColumnSpacing="13">
                        <BoxView Grid.Column="0" HeightRequest="12" CornerRadius="3" Color="{StaticResource SurfaceRaised}" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <BoxView HeightRequest="13" WidthRequest="140" CornerRadius="3" Color="{StaticResource SurfaceRaised}" HorizontalOptions="Start" />
                            <BoxView HeightRequest="9" WidthRequest="70" CornerRadius="3" Color="{StaticResource SurfaceRaised}" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                        <BoxView Grid.Column="2" HeightRequest="12" CornerRadius="3" Color="{StaticResource SurfaceRaised}" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="24,*,64" ColumnSpacing="13">
                        <BoxView Grid.Column="0" HeightRequest="12" CornerRadius="3" Color="{StaticResource SurfaceRaised}" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <BoxView HeightRequest="13" WidthRequest="110" CornerRadius="3" Color="{StaticResource SurfaceRaised}" HorizontalOptions="Start" />
                            <BoxView HeightRequest="9" WidthRequest="90" CornerRadius="3" Color="{StaticResource SurfaceRaised}" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                        <BoxView Grid.Column="2" HeightRequest="12" CornerRadius="3" Color="{StaticResource SurfaceRaised}" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="24,*,64" ColumnSpacing="13">
                        <BoxView Grid.Column="0" HeightRequest="12" CornerRadius="3" Color="{StaticResource SurfaceRaised}" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <BoxView HeightRequest="13" WidthRequest="130" CornerRadius="3" Color="{StaticResource SurfaceRaised}" HorizontalOptions="Start" />
                            <BoxView HeightRequest="9" WidthRequest="75" CornerRadius="3" Color="{StaticResource SurfaceRaised}" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                        <BoxView Grid.Column="2" HeightRequest="12" CornerRadius="3" Color="{StaticResource SurfaceRaised}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </controls:SkeletonPanel>

        <!-- Stat strip (prototype C3): three tiles — DIVES (mint) · MAX (unit-aware) · BOTTOM (hours).
             Hidden while empty. Each tile announces once; numeral + caption children excluded from
             the a11y tree so TalkBack does not announce the value twice. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="7" Margin="24,4" IsVisible="{Binding ShowDives}">
            <Border Grid.Column="0" Style="{StaticResource GlassCard}" SemanticProperties.Description="{Binding TotalDives, StringFormat='{0} dives logged'}">
                <VerticalStackLayout Spacing="{StaticResource TightSpacing}">
                    <Label Style="{StaticResource StatNumeralMint}" StyleClass="tnum" Text="{Binding TotalDives}" HorizontalTextAlignment="Center" AutomationProperties.IsInAccessibleTree="False" />
                    <Label Style="{StaticResource MonoLabel}" Text="DIVES" HorizontalTextAlignment="Center" AutomationProperties.IsInAccessibleTree="False" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource GlassCard}" SemanticProperties.Description="{Binding StatMaxText, StringFormat='Max depth {0}'}">
                <VerticalStackLayout Spacing="{StaticResource TightSpacing}">
                    <Label Style="{StaticResource StatNumeral}" StyleClass="tnum" Text="{Binding StatMaxText}" HorizontalTextAlignment="Center" AutomationProperties.IsInAccessibleTree="False" />
                    <Label Style="{StaticResource MonoLabel}" Text="{Binding StatMaxLabel}" HorizontalTextAlignment="Center" AutomationProperties.IsInAccessibleTree="False" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource GlassCard}" SemanticProperties.Description="{Binding StatHoursText, StringFormat='Total bottom time {0}'}">
                <VerticalStackLayout Spacing="{StaticResource TightSpacing}">
                    <Label Style="{StaticResource StatNumeral}" StyleClass="tnum" Text="{Binding StatHoursText}" HorizontalTextAlignment="Center" AutomationProperties.IsInAccessibleTree="False" />
                    <Label Style="{StaticResource MonoLabel}" Text="BOTTOM" HorizontalTextAlignment="Center" AutomationProperties.IsInAccessibleTree="False" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Free-tier cap meter (visible near/over the cap; icon + text + meter, never color alone). -->
        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Margin="24,4" IsVisible="{Binding IsCapMeterVisible}">
            <VerticalStackLayout Spacing="{StaticResource CardSpacing}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <controls:AppIcon
                        Grid.Column="0"
                        Icon="warning"
                        Size="16"
                        Color="{AppThemeBinding Light={StaticResource LightWarn}, Dark={StaticResource Warn}}"
                        VerticalOptions="Start"
                        Margin="0,1,0,0" />
                    <Label Grid.Column="1" Style="{StaticResource Caption13}" LineBreakMode="WordWrap">
                        <Label.FormattedText>
                            <FormattedString>
                                <!-- The cap number is sourced from Trimix.Contracts.FreeTier (the constant
                                     that enforces the cap), never a hardcoded "25", so copy and enforcement
                                     can never drift. -->
                                <Span Text="{Binding TotalDives}" />
                                <Span Text=" dives logged — the free logbook shows the latest " />
                                <Span Text="{Binding Source={x:Static contracts:FreeTier.FreeLogbookVisibleDives}, StringFormat='{}{0}.'}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Grid>
                <ProgressBar
                    Style="{StaticResource CapMeterWarn}"
                    Progress="{Binding CapProgress}"
                    SemanticProperties.Description="{Binding HiddenDiveCount, StringFormat='Free logbook cap meter. {0} dives hidden.'}" />
                <Label
                    Style="{StaticResource Caption13}"
                    IsVisible="{Binding HiddenDiveCount, Converter={StaticResource IntGreaterThanZero}}"
                    Text="{Binding HiddenDiveCount, StringFormat='{0} older dives are hidden by the free cap.'}" />
                <Button
                    Style="{StaticResource SecondaryButton}"
                    Text="Unlock unlimited logbook"
                    Command="{Binding UpgradeCommand}"
                    SemanticProperties.Description="Unlock unlimited logbook"
                    SemanticProperties.Hint="Shows the Pro and Lifetime one-off purchase options" />
            </VerticalStackLayout>
        </Border>

        <!-- Dive cards (populated). -->
        <CollectionView
            Grid.Row="3"
            ItemsSource="{Binding VisibleDives}"
            SelectionMode="None"
            Margin="24,8,24,0"
            IsVisible="{Binding ShowDives}">
            <CollectionView.ItemTemplate>
                <!-- Prototype C3 dive row: sequence # (mint) · dive date · the origin→destination
                     route string (GARMIN → PADI · SSI) · right column depth / NNmin / gas tag. Each
                     row is a DiveRowItem over a MergedDive union; tapping opens the union's dive.
                     Loaded → the design's rowIn stagger (code-behind). -->
                <DataTemplate x:DataType="vm:DiveRowItem">
                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="13"
                        Padding="4,13"
                        Loaded="OnRowLoaded"
                        SemanticProperties.Description="{Binding Title}"
                        SemanticProperties.Hint="Opens the dive's details">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding OpenDiveCommand, Source={RelativeSource AncestorType={x:Type vm:LogbookViewModel}}, x:DataType=vm:LogbookViewModel}"
                                CommandParameter="{Binding Merged.Primary}" />
                        </Grid.GestureRecognizers>
                        <!-- Sequence number (mint, mono). -->
                        <Label
                            Grid.Column="0"
                            Style="{StaticResource MonoLabelMint}"
                            StyleClass="tnum"
                            Text="{Binding Number}"
                            FontSize="13"
                            WidthRequest="24"
                            VerticalOptions="Center"
                            AutomationProperties.IsInAccessibleTree="False" />
                        <!-- Dive date · route string. -->
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <!-- Title + DECO badge. The badge only appears when the provider reported the
                                 dive as decompression — absent data must never read as "no deco". -->
                            <HorizontalStackLayout Spacing="6">
                                <Label Style="{StaticResource Heading18}" FontSize="14" Text="{Binding Title}" VerticalOptions="Center" />
                                <Border Style="{StaticResource BadgeMint}" IsVisible="{Binding HasDeco}" VerticalOptions="Center">
                                    <Label Style="{StaticResource BadgeTextMint}" Text="DECO" FontSize="7.5" />
                                </Border>
                            </HorizontalStackLayout>
                            <!-- One badge per provider that recorded this physical dive, in priority order
                                 (primary first), then the push-destination suffix ("→ PADI · SSI"). -->
                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Badges}" VerticalOptions="Center">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="stats:DiveSourceBadge">
                                            <Border Style="{StaticResource BadgeMint}" VerticalOptions="Center">
                                                <Label Style="{StaticResource BadgeTextMint}" Text="{Binding Label}" FontSize="7.5" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                                <Label Style="{StaticResource MonoLabelMint}" FontSize="8.5" Opacity="0.75"
                                       Text="{Binding Destinations}" TextTransform="None"
                                       IsVisible="{Binding HasDestinations}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <!-- Provider-reported meta (temp · type · tag); hidden when nothing was reported. -->
                            <Label Style="{StaticResource Caption13}" FontSize="10" Opacity="0.7"
                                   Text="{Binding MetaText}" IsVisible="{Binding HasMeta}" />
                        </VerticalStackLayout>
                        <!-- Depth · minutes · gas tag. -->
                        <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="End" VerticalOptions="Center">
                            <Label Style="{StaticResource Body15}" StyleClass="tnum" FontSize="12" FontFamily="JetBrainsMonoSemiBold" Text="{Binding DepthText}" HorizontalTextAlignment="End" />
                            <Label Style="{StaticResource Caption13}" StyleClass="tnum" FontSize="12" FontFamily="JetBrainsMono" Text="{Binding TimeText}" HorizontalTextAlignment="End" />
                            <Border Style="{StaticResource Chip}" HorizontalOptions="End" Padding="6,2" Margin="0,4,0,0">
                                <Label Style="{StaticResource ChipLabel}" FontSize="8.5" Text="{Binding Gas}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <!-- Bottom spacer so the last dive scrolls clear of / under the floating iOS tab bar. -->
            <CollectionView.Footer>
                <BoxView Color="Transparent" HeightRequest="{StaticResource TabScrollBottomInset}" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- Empty state (design "No dives yet"): centered mint trend glyph + copy. Linking a platform
             is done from the `+` add sheet → "Manage providers", so no CTA button here. -->
        <Grid Grid.Row="3" IsVisible="{Binding ShowEmptyState}" Padding="{StaticResource PageContentPadding}">

            <VerticalStackLayout VerticalOptions="Center" Spacing="16">
                <!-- The design's trend glyph (46px, stroke 1.5, opacity .6). -->
                <controls:AppIcon
                    Icon="trend"
                    Size="46"
                    StrokeThickness="1.5"
                    Opacity="0.6"
                    HorizontalOptions="Center"
                    AutomationProperties.IsInAccessibleTree="False" />
                <Label
                    Style="{StaticResource Heading18}"
                    Text="No dives yet"
                    HorizontalTextAlignment="Center" />
                <Label
                    Style="{StaticResource Body15}"
                    TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource TextSecondary}}"
                    Text="Connect a dive computer or training center and your dives will appear here on their own."
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>

    <!-- ================= `+` FAB (opens the add sheet) — AppIcon plus, never a text glyph ================= -->
    <Border
        StrokeShape="RoundRectangle 28"
        StrokeThickness="0"
        WidthRequest="56"
        HeightRequest="56"
        HorizontalOptions="End"
        VerticalOptions="End"
        Margin="0,0,20,24"
        Background="{AppThemeBinding Light={StaticResource LightSonar}, Dark={StaticResource Sonar}}"
        SemanticProperties.Description="Add"
        SemanticProperties.Hint="Opens sync and provider options">
        <controls:AppIcon
            Icon="plus"
            Size="24"
            StrokeThickness="2"
            Color="{StaticResource MintInk}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenAddSheetCommand}" />
        </Border.GestureRecognizers>
    </Border>

    <!-- The add + streaming-sync bottom sheets live in SheetOverlayPage, a transparent modal pushed
         over the whole window (above the Shell tab bar) by the code-behind when their VM flags rise —
         so each card overlays the tab bar with the menu dimmed underneath it. -->

    </Grid>
</controls:TrimixPage>
