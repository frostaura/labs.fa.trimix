<?xml version="1.0" encoding="utf-8" ?>
<!-- Logbook home (mockup S4 empty / S10 populated): in-page "Logbook" title + mint-ringed avatar ·
     running-stats strip as instrument numerals (mint DIVES + white MAX/BOTTOM) · dive cards · free-tier
     cap meter near the cap (paywall_shown trigger=logbook_cap via the VM) · empty state with a mint
     line-chart glyph and the dual Import (mint CTA-card) / Manual (ghost) CTAs. -->
<ContentPage
    x:Class="Trimix.App.Pages.LogbookPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Trimix.Core.ViewModels;assembly=Trimix.Core"
    xmlns:dtos="clr-namespace:Trimix.Contracts.Dtos;assembly=Trimix.Contracts"
    xmlns:stats="clr-namespace:Trimix.Core.Stats;assembly=Trimix.Core"
    xmlns:contracts="clr-namespace:Trimix.Contracts;assembly=Trimix.Contracts"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    x:DataType="vm:LogbookViewModel"
    Title="Logbook">

    <!-- Outer grid overlays the `+` FAB, the add sheet and the streaming sync sheet on the page. -->
    <Grid>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Header: big screen title + circular mint-ringed avatar. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,16,24,8" VerticalOptions="Center">
            <Label
                Grid.Column="0"
                Style="{StaticResource Title24}"
                Text="Logbook"
                VerticalOptions="Center"
                SemanticProperties.HeadingLevel="Level1" />
            <Grid Grid.Column="1" WidthRequest="44" HeightRequest="44" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False">
                <shapes:Ellipse Stroke="{StaticResource SonarBrush}" StrokeThickness="1.5" Fill="{StaticResource SurfaceRaisedBrush}" WidthRequest="44" HeightRequest="44" />
                <shapes:Ellipse Fill="{StaticResource SonarBrush}" Opacity="0.9" WidthRequest="14" HeightRequest="14" HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>
        </Grid>

        <!-- Stat strip (prototype C3): three tiles — DIVES (mint) · MAX (unit-aware) · BOTTOM (hours).
             Hidden while empty. Each tile announces once; numeral + caption children excluded from
             the a11y tree so TalkBack does not announce the value twice. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="7" Margin="24,4" IsVisible="{Binding IsEmpty, Converter={StaticResource InverseBool}}">
            <Border Grid.Column="0" Style="{StaticResource GlassCard}" SemanticProperties.Description="{Binding TotalDives, StringFormat='{0} dives logged'}">
                <VerticalStackLayout Spacing="{StaticResource TightSpacing}">
                    <Label Style="{StaticResource StatNumeralMint}" StyleClass="tnum" Text="{Binding TotalDives}" HorizontalTextAlignment="Center" AutomationProperties.IsInAccessibleTree="False" />
                    <Label Style="{StaticResource MonoLabel}" Text="DIVES" HorizontalTextAlignment="Center" AutomationProperties.IsInAccessibleTree="False" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource GlassCard}" SemanticProperties.Description="{Binding StatMaxText, StringFormat='Max depth {0}'}">
                <VerticalStackLayout Spacing="{StaticResource TightSpacing}">
                    <Label Style="{StaticResource StatNumeral}" StyleClass="tnum" Text="{Binding StatMaxText}" HorizontalTextAlignment="Center" AutomationProperties.IsInAccessibleTree="False" />
                    <Label Style="{StaticResource MonoLabel}" Text="{Binding StatMaxLabel}" HorizontalTextAlignment="Center" AutomationProperties.IsInAccessibleTree="False" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource GlassCard}" SemanticProperties.Description="{Binding StatHoursText, StringFormat='Total bottom time {0}'}">
                <VerticalStackLayout Spacing="{StaticResource TightSpacing}">
                    <Label Style="{StaticResource StatNumeral}" StyleClass="tnum" Text="{Binding StatHoursText}" HorizontalTextAlignment="Center" AutomationProperties.IsInAccessibleTree="False" />
                    <Label Style="{StaticResource MonoLabel}" Text="BOTTOM" HorizontalTextAlignment="Center" AutomationProperties.IsInAccessibleTree="False" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Free-tier cap meter (visible near/over the cap; icon + text + meter, never color alone). -->
        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Margin="24,4" IsVisible="{Binding IsCapMeterVisible}">
            <VerticalStackLayout Spacing="{StaticResource CardSpacing}">
                <Label Style="{StaticResource Caption13}">
                    <Label.FormattedText>
                        <FormattedString>
                            <!-- The cap number is sourced from Trimix.Contracts.FreeTier (the constant
                                 that enforces the cap), never a hardcoded "25", so copy and enforcement
                                 can never drift. -->
                            <Span Text="⚠ " TextColor="{AppThemeBinding Light={StaticResource LightWarn}, Dark={StaticResource Warn}}" />
                            <Span Text="{Binding TotalDives}" />
                            <Span Text=" dives logged — the free logbook shows the latest " />
                            <Span Text="{Binding Source={x:Static contracts:FreeTier.FreeLogbookVisibleDives}, StringFormat='{}{0}.'}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <ProgressBar
                    Style="{StaticResource CapMeterWarn}"
                    Progress="{Binding CapProgress}"
                    SemanticProperties.Description="{Binding HiddenDiveCount, StringFormat='Free logbook cap meter. {0} dives hidden.'}" />
                <Label
                    Style="{StaticResource Caption13}"
                    IsVisible="{Binding HiddenDiveCount, Converter={StaticResource IntGreaterThanZero}}"
                    Text="{Binding HiddenDiveCount, StringFormat='{0} older dives are hidden by the free cap.'}" />
                <Button
                    Style="{StaticResource SecondaryButton}"
                    Text="Unlock unlimited logbook"
                    Command="{Binding UpgradeCommand}"
                    SemanticProperties.Description="Unlock unlimited logbook"
                    SemanticProperties.Hint="Shows the Pro and Lifetime one-off purchase options" />
            </VerticalStackLayout>
        </Border>

        <!-- Dive cards (populated). -->
        <CollectionView
            Grid.Row="3"
            ItemsSource="{Binding VisibleDives}"
            SelectionMode="None"
            Margin="24,8,24,0"
            IsVisible="{Binding IsEmpty, Converter={StaticResource InverseBool}}">
            <CollectionView.ItemTemplate>
                <!-- Prototype C3 dive row: sequence # (mint) · site · "location · date" · the
                     origin→destination route string (GARMIN → PADI · SSI) · right column depth /
                     NNmin / gas tag. Each row is a DiveRowItem over a MergedDive union; tapping
                     opens the union's dive. -->
                <DataTemplate x:DataType="vm:DiveRowItem">
                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="13"
                        Padding="4,13"
                        SemanticProperties.Description="{Binding Site}"
                        SemanticProperties.Hint="Opens the dive's details">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding OpenDiveCommand, Source={RelativeSource AncestorType={x:Type vm:LogbookViewModel}}, x:DataType=vm:LogbookViewModel}"
                                CommandParameter="{Binding Merged.Primary}" />
                        </Grid.GestureRecognizers>
                        <!-- Sequence number (mint, mono). -->
                        <Label
                            Grid.Column="0"
                            Style="{StaticResource MonoLabelMint}"
                            StyleClass="tnum"
                            Text="{Binding Number}"
                            FontSize="13"
                            WidthRequest="24"
                            VerticalOptions="Center"
                            AutomationProperties.IsInAccessibleTree="False" />
                        <!-- Site · location · date · route string. -->
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Style="{StaticResource Heading18}" FontSize="14" Text="{Binding Site}" />
                            <Label Style="{StaticResource Caption13}" FontSize="11" Text="{Binding Meta}" />
                            <Label Style="{StaticResource MonoLabelMint}" FontSize="8.5" Opacity="0.75" Text="{Binding Route}" TextTransform="None" />
                        </VerticalStackLayout>
                        <!-- Depth · minutes · gas tag. -->
                        <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="End" VerticalOptions="Center">
                            <Label Style="{StaticResource Body15}" StyleClass="tnum" FontSize="12" FontFamily="JetBrainsMonoSemiBold" Text="{Binding DepthText}" HorizontalTextAlignment="End" />
                            <Label Style="{StaticResource Caption13}" StyleClass="tnum" FontSize="12" FontFamily="JetBrainsMono" Text="{Binding TimeText}" HorizontalTextAlignment="End" />
                            <Border Style="{StaticResource Chip}" HorizontalOptions="End" Padding="6,2" Margin="0,4,0,0">
                                <Label Style="{StaticResource ChipLabel}" FontSize="8.5" Text="{Binding Gas}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <!-- Bottom spacer so the last dive scrolls clear of / under the floating iOS tab bar. -->
            <CollectionView.Footer>
                <BoxView Color="Transparent" HeightRequest="{StaticResource TabScrollBottomInset}" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- Empty state (S4): centered mint line-chart glyph + copy; dual CTA pinned near the bottom. -->
        <Grid Grid.Row="3" IsVisible="{Binding IsEmpty}" RowDefinitions="*,Auto" Padding="{StaticResource PageContentPadding}" RowSpacing="{StaticResource SectionSpacing}">

            <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" Spacing="16">
                <!-- Mint line-chart glyph: faint baseline + rising mint zig. -->
                <Grid WidthRequest="96" HeightRequest="56" HorizontalOptions="Center" AutomationProperties.IsInAccessibleTree="False">
                    <shapes:Polyline Points="0,54 96,54" Stroke="{StaticResource GlassStrokeBrush}" StrokeThickness="1" />
                    <shapes:Polyline Points="2,44 20,30 38,36 56,14 74,22 94,4" Stroke="{StaticResource SonarBrush}" StrokeThickness="2.5" StrokeLineJoin="Round" StrokeLineCap="Round" />
                </Grid>
                <Label
                    Style="{StaticResource Heading18}"
                    Text="No dives yet"
                    HorizontalTextAlignment="Center" />
                <Label
                    Style="{StaticResource Body15}"
                    TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource TextSecondary}}"
                    Text="Connect a dive computer or training center and your dives will appear here on their own."
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Empty-state CTA (prototype S4): route to Providers — no manual entry, no BLE. -->
            <Button
                Grid.Row="1"
                Style="{StaticResource PrimaryButton}"
                Text="Connect your computer or dive center"
                Command="{Binding ManageProvidersCommand}"
                SemanticProperties.Description="Connect your computer or dive center"
                SemanticProperties.Hint="Opens the Providers list to link a platform" />
        </Grid>
    </Grid>

    <!-- ================= `+` FAB (opens the add sheet) ================= -->
    <Button
        Text="+"
        Command="{Binding OpenAddSheetCommand}"
        HorizontalOptions="End"
        VerticalOptions="End"
        Margin="0,0,20,24"
        WidthRequest="56"
        HeightRequest="56"
        MinimumWidthRequest="56"
        MinimumHeightRequest="56"
        Padding="0"
        CornerRadius="28"
        FontSize="26"
        FontFamily="SpaceGroteskBold"
        BackgroundColor="{AppThemeBinding Light={StaticResource LightSonar}, Dark={StaticResource Sonar}}"
        TextColor="{StaticResource MintInk}"
        SemanticProperties.Description="Add"
        SemanticProperties.Hint="Opens sync and provider options" />

    <!-- ================= Add sheet scrim + sheet (Sync now · Manage providers ONLY) ================= -->
    <BoxView
        Color="#7304080A"
        IsVisible="{Binding IsAddSheetOpen}"
        SemanticProperties.Description="Dismiss options">
        <BoxView.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding CloseAddSheetCommand}" />
        </BoxView.GestureRecognizers>
    </BoxView>

    <Border
        IsVisible="{Binding IsAddSheetOpen}"
        VerticalOptions="End"
        StrokeThickness="0"
        Background="{AppThemeBinding Light={StaticResource LightSurfaceBrush}, Dark={StaticResource SurfaceBrush}}"
        StrokeShape="RoundRectangle 24,24,0,0"
        Padding="22,14,22,30">
        <VerticalStackLayout Spacing="{StaticResource CardSpacing}">
            <BoxView WidthRequest="36" HeightRequest="4" CornerRadius="2" HorizontalOptions="Center"
                     Color="{AppThemeBinding Light={StaticResource LightGlassStroke}, Dark={StaticResource GlassStroke}}"
                     AutomationProperties.IsInAccessibleTree="False" />

            <!-- Sync now -->
            <Border Style="{StaticResource GlassCard}"
                    SemanticProperties.Description="Sync now"
                    SemanticProperties.Hint="Pulls and pushes dives across linked providers">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SyncNowCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="2">
                    <Label Style="{StaticResource Heading18}" Text="Sync now" />
                    <Label Style="{StaticResource Caption13}" Text="Pull and push dives across linked providers" />
                </VerticalStackLayout>
            </Border>

            <!-- Manage providers -->
            <Border Style="{StaticResource GlassCard}"
                    SemanticProperties.Description="Manage providers"
                    SemanticProperties.Hint="Link or unlink your platforms">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ManageProvidersCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="2">
                    <Label Style="{StaticResource Heading18}" Text="Manage providers" />
                    <Label Style="{StaticResource Caption13}" Text="Link or unlink your platforms" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Border>

    <!-- ================= Streaming sync sheet (bound to the shared SyncSessionViewModel) ================= -->
    <BoxView
        Color="#5904080A"
        IsVisible="{Binding Sync.IsSyncing}"
        InputTransparent="True" />

    <Border
        IsVisible="{Binding Sync.IsSyncing}"
        VerticalOptions="End"
        StrokeThickness="0"
        Background="{AppThemeBinding Light={StaticResource LightSurfaceBrush}, Dark={StaticResource SurfaceBrush}}"
        StrokeShape="RoundRectangle 24,24,0,0"
        Padding="22,16,22,28">
        <VerticalStackLayout Spacing="{StaticResource CardSpacing}">
            <Label Style="{StaticResource Heading18}" Text="Syncing…" SemanticProperties.HeadingLevel="Level2" />
            <Label Style="{StaticResource MonoLabelMint}" Text="{Binding Sync.SyncLabel}" TextTransform="None" />
            <ProgressBar
                Progress="{Binding Sync.Progress}"
                SemanticProperties.Description="{Binding Sync.SyncSub}" />
            <Label
                Style="{StaticResource Caption13}"
                Text="{Binding Sync.SyncSub}"
                AutomationProperties.IsInAccessibleTree="False" />
        </VerticalStackLayout>
    </Border>

    </Grid>
</ContentPage>
