<?xml version="1.0" encoding="utf-8" ?>
<!-- Dive detail (S6 / mockup 1:1): mint-on-Abyss. Ghost mint back · "Dive" title + IMPORTED badge ·
     date/source subtitle · 2x2 GlassCard stat grid (MAX DEPTH mint · BOTTOM TIME white · MIN TEMP mint ·
     GAS white) · "DEPTH / TIME" GlassCard holding the Core GraphicsView profile chart (x:Name=ChartView,
     mint line) with the accessibility-mandated "view as table" alternative · site/details/notes cards ·
     pinned "Match the site →" primary pill (OpenSiteCommand). Visual layer only — every binding preserved. -->
<ContentPage
    x:Class="Trimix.App.Pages.DiveDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Trimix.Core.ViewModels;assembly=Trimix.Core"
    x:DataType="vm:DiveDetailViewModel"
    Shell.PresentationMode="ModalAnimated"
    Title="Dive">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header controls: ghost mint back (CloseCommand preserved) + Export action (ExportCommand). -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <Button
                Grid.Column="0"
                Style="{StaticResource BackButton}"
                Text="←"
                Command="{Binding CloseCommand}"
                Margin="10,8,0,0"
                MinimumWidthRequest="44"
                SemanticProperties.Description="Back"
                SemanticProperties.Hint="Returns to the previous screen" />

            <!-- Export to a standards-based file the diver owns (UDDF / DL7 / PDF) → OS save/share sheet. -->
            <Button
                Grid.Column="2"
                Style="{StaticResource BackButton}"
                Text="Export"
                Command="{Binding ExportCommand}"
                Margin="0,8,14,0"
                MinimumWidthRequest="44"
                SemanticProperties.Description="Export dive"
                SemanticProperties.Hint="Opens format options to save or share this dive as a file" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{StaticResource PageContentPadding}" Spacing="{StaticResource SectionSpacing}">

                <!-- Header: title + IMPORTED badge, date · source subtitle. -->
                <VerticalStackLayout Spacing="{StaticResource TightSpacing}">
                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="12" VerticalOptions="Center">
                        <Label
                            Grid.Column="0"
                            Style="{StaticResource Title24}"
                            Text="Dive"
                            VerticalOptions="Center"
                            SemanticProperties.HeadingLevel="Level1" />
                        <Border Grid.Column="1" Style="{StaticResource BadgeMint}">
                            <Label Style="{StaticResource BadgeTextMint}" Text="IMPORTED" />
                        </Border>
                    </Grid>
                    <HorizontalStackLayout Spacing="6">
                        <Label Style="{StaticResource Caption13}" Text="{Binding Dive.StartUtc, Converter={StaticResource DateFormat}}" />
                        <Label Style="{StaticResource Caption13}" Text="·" IsVisible="{Binding Dive.Source, Converter={StaticResource StringNotEmpty}}" />
                        <Label Style="{StaticResource Caption13}" Text="{Binding Dive.Source}" IsVisible="{Binding Dive.Source, Converter={StaticResource StringNotEmpty}}" />
                    </HorizontalStackLayout>

                    <!-- Cross-source merge (§3 / §8.2): one physical dive, several sources → badged. -->
                    <VerticalStackLayout Spacing="{StaticResource TightSpacing}" IsVisible="{Binding IsMerged}">
                        <Label Style="{StaticResource MonoLabelDim}" Text="SOURCES" />
                        <FlexLayout
                            Wrap="Wrap" JustifyContent="Start" AlignItems="Center"
                            BindableLayout.ItemsSource="{Binding SourceBadges}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Style="{StaticResource BadgeMint}" Margin="0,0,8,0">
                                        <Label Style="{StaticResource BadgeTextMint}" Text="{Binding .}" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- 2x2 stat grid. Each tile announces once; numeral + suffix excluded from the a11y tree. -->
                <Grid RowDefinitions="*,*" ColumnDefinitions="*,*" RowSpacing="{StaticResource CardSpacing}" ColumnSpacing="{StaticResource CardSpacing}">

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource GlassCard}">
                        <VerticalStackLayout Spacing="{StaticResource TightSpacing}" SemanticProperties.Description="{Binding MaxDepthText, StringFormat='Max depth {0}'}">
                            <Label Style="{StaticResource MonoLabel}" Text="MAX DEPTH" AutomationProperties.IsInAccessibleTree="False" />
                            <HorizontalStackLayout Spacing="3">
                                <Label Style="{StaticResource StatNumeralMint}" StyleClass="tnum" Text="{Binding MaxDepthText, Converter={StaticResource UnitPrefixPart}}" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Style="{StaticResource UnitSuffix}" Text="{Binding MaxDepthText, Converter={StaticResource UnitSuffixPart}}" VerticalOptions="End" Margin="0,0,0,4" AutomationProperties.IsInAccessibleTree="False" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource GlassCard}">
                        <VerticalStackLayout Spacing="{StaticResource TightSpacing}" SemanticProperties.Description="{Binding DurationText, StringFormat='Bottom time {0}'}">
                            <Label Style="{StaticResource MonoLabel}" Text="BOTTOM TIME" AutomationProperties.IsInAccessibleTree="False" />
                            <HorizontalStackLayout Spacing="3">
                                <Label Style="{StaticResource StatNumeral}" StyleClass="tnum" Text="{Binding DurationText, Converter={StaticResource UnitPrefixPart}}" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Style="{StaticResource UnitSuffix}" Text="{Binding DurationText, Converter={StaticResource UnitSuffixPart}}" VerticalOptions="End" Margin="0,0,0,4" AutomationProperties.IsInAccessibleTree="False" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource GlassCard}">
                        <VerticalStackLayout Spacing="{StaticResource TightSpacing}" SemanticProperties.Description="{Binding MinTempText, StringFormat='Minimum temperature {0}'}">
                            <Label Style="{StaticResource MonoLabel}" Text="MIN TEMP" AutomationProperties.IsInAccessibleTree="False" />
                            <HorizontalStackLayout Spacing="3">
                                <Label Style="{StaticResource StatNumeralMint}" StyleClass="tnum" Text="{Binding MinTempText, Converter={StaticResource UnitPrefixPart}}" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Style="{StaticResource UnitSuffix}" Text="{Binding MinTempText, Converter={StaticResource UnitSuffixPart}}" VerticalOptions="End" Margin="0,0,0,4" AutomationProperties.IsInAccessibleTree="False" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource GlassCard}">
                        <VerticalStackLayout Spacing="{StaticResource TightSpacing}" SemanticProperties.Description="{Binding Dive.GasMix, StringFormat='Gas {0}'}">
                            <Label Style="{StaticResource MonoLabel}" Text="GAS" AutomationProperties.IsInAccessibleTree="False" />
                            <Label Style="{StaticResource StatNumeral}" StyleClass="tnum" Text="{Binding Dive.GasMix}" AutomationProperties.IsInAccessibleTree="False" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- DEPTH / TIME — Core GraphicsView profile chart (mint) + accessible table alternative. -->
                <Border Style="{StaticResource GlassCard}">
                    <VerticalStackLayout Spacing="{StaticResource CardSpacing}">
                        <Label Style="{StaticResource MonoLabel}" Text="DEPTH / TIME" SemanticProperties.HeadingLevel="Level2" />
                        <GraphicsView
                            x:Name="ChartView"
                            HeightRequest="220"
                            IsVisible="{Binding Chart.IsEmpty, Converter={StaticResource InverseBool}}"
                            SemanticProperties.Description="{Binding ChartSemanticDescription}" />

                        <!-- Non-color legend (WCAG 1.4.1): channel identity by text + swatch, never hue alone.
                             Each entry shows only when that overlay is actually drawn. -->
                        <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center" IsVisible="{Binding HasOverlayLegend}">
                            <HorizontalStackLayout Spacing="6" Margin="0,0,14,4">
                                <BoxView WidthRequest="12" HeightRequest="3" CornerRadius="2" VerticalOptions="Center"
                                         Color="{AppThemeBinding Light={StaticResource LightSonarDeep}, Dark={StaticResource Sonar}}"
                                         AutomationProperties.IsInAccessibleTree="False" />
                                <Label Style="{StaticResource Caption13}" Text="Depth" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6" Margin="0,0,14,4" IsVisible="{Binding HasTemperatureOverlay}">
                                <BoxView WidthRequest="12" HeightRequest="3" CornerRadius="2" VerticalOptions="Center"
                                         Color="{AppThemeBinding Light={StaticResource LightIce}, Dark={StaticResource Ice}}"
                                         AutomationProperties.IsInAccessibleTree="False" />
                                <Label Style="{StaticResource Caption13}" Text="Temp" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6" Margin="0,0,14,4" IsVisible="{Binding HasTankOverlay}">
                                <BoxView WidthRequest="12" HeightRequest="3" CornerRadius="2" VerticalOptions="Center"
                                         Color="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource TextSecondary}}"
                                         AutomationProperties.IsInAccessibleTree="False" />
                                <Label Style="{StaticResource Caption13}" Text="Tank" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6" Margin="0,0,14,4" IsVisible="{Binding HasCeilingOverlay}">
                                <BoxView WidthRequest="12" HeightRequest="10" CornerRadius="2" Opacity="0.5" VerticalOptions="Center"
                                         Color="{AppThemeBinding Light={StaticResource LightWarn}, Dark={StaticResource Warn}}"
                                         AutomationProperties.IsInAccessibleTree="False" />
                                <Label Style="{StaticResource Caption13}" Text="Ceiling zone" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6" Margin="0,0,14,4" IsVisible="{Binding HasEventMarkers}">
                                <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" VerticalOptions="Center"
                                         Color="{AppThemeBinding Light={StaticResource LightWarn}, Dark={StaticResource Warn}}"
                                         AutomationProperties.IsInAccessibleTree="False" />
                                <Label Style="{StaticResource Caption13}" Text="Events" />
                            </HorizontalStackLayout>
                        </FlexLayout>

                        <Label
                            Style="{StaticResource Caption13}"
                            Text="No profile samples — manually logged dives carry summary numbers only."
                            IsVisible="{Binding Chart.IsEmpty}" />
                        <Button
                            Style="{StaticResource SecondaryButton}"
                            Text="View as table"
                            Command="{Binding ToggleProfileTableCommand}"
                            IsVisible="{Binding Chart.IsEmpty, Converter={StaticResource InverseBool}}"
                            SemanticProperties.Description="View profile as table"
                            SemanticProperties.Hint="Shows or hides the dive profile as a data table">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsProfileTableVisible}" Value="True">
                                    <Setter Property="Text" Value="Hide table" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <!-- Columnar WCAG alternative (§8.4): columns appear only for channels the dive
                             recorded, so the table grows exactly with the drawn overlays. Header + each
                             row are horizontally scrollable string collections. -->
                        <ScrollView Orientation="Horizontal" IsVisible="{Binding IsProfileTableVisible}">
                            <VerticalStackLayout Spacing="0">
                                <HorizontalStackLayout Padding="0,8" Spacing="16" BindableLayout.ItemsSource="{Binding ProfileTableHeaders}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Label Style="{StaticResource Caption13}" Text="{Binding .}" FontAttributes="Bold" WidthRequest="56" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                                <BoxView />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ProfileTable}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProfileTableRow">
                                            <HorizontalStackLayout Padding="0,6" Spacing="16" BindableLayout.ItemsSource="{Binding Cells}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Label Style="{StaticResource Body15}" StyleClass="tnum" Text="{Binding .}" WidthRequest="56" />
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </HorizontalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <!-- Recorded (imported) deco channels — display-only. These surface values the dive
                     computer STORED (min NDL, deepest ceiling, peak CNS); Trimix never computes tissue
                     loading or deco (frozen liability line). -->
                <Border Style="{StaticResource GlassCard}" IsVisible="{Binding HasRecordedReadouts}">
                    <VerticalStackLayout Spacing="{StaticResource CardSpacing}">
                        <Label Style="{StaticResource MonoLabel}" Text="RECORDED (IMPORTED)" SemanticProperties.HeadingLevel="Level2" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecordedReadouts}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecordedReadout">
                                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                                        <Label Grid.Column="0" Style="{StaticResource Caption13}" Text="{Binding Label}" />
                                        <Label Grid.Column="1" Style="{StaticResource Body15}" StyleClass="tnum" Text="{Binding Value}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Site block (tap → site detail). -->
                <Border
                    Style="{StaticResource GlassCard}"
                    IsVisible="{Binding SiteName, Converter={StaticResource StringNotEmpty}}"
                    SemanticProperties.Description="{Binding SiteName, StringFormat='Dive site {0}'}"
                    SemanticProperties.Hint="Opens the dive site's details">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenSiteCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="44">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Style="{StaticResource MonoLabel}" Text="DIVE SITE" />
                            <Label Style="{StaticResource Heading18}" Text="{Binding SiteName}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Style="{StaticResource Heading18}" Text="›" VerticalOptions="Center"
                               AutomationProperties.IsInAccessibleTree="False"
                               TextColor="{AppThemeBinding Light={StaticResource LightSonarDeep}, Dark={StaticResource Sonar}}" />
                    </Grid>
                </Border>

                <!-- Details chips: source, gas, gear, buddies, rating. -->
                <Border Style="{StaticResource GlassCard}">
                    <VerticalStackLayout Spacing="{StaticResource CardSpacing}">
                        <Label Style="{StaticResource MonoLabel}" Text="DETAILS" SemanticProperties.HeadingLevel="Level2" />
                        <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
                            <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                                <Label Style="{StaticResource ChipLabel}" Text="{Binding Dive.Source, StringFormat='source: {0}'}" />
                            </Border>
                            <Border Style="{StaticResource ChipSelected}" Margin="0,0,8,8" IsVisible="{Binding Dive.GasMix, Converter={StaticResource StringNotEmpty}}">
                                <Label Style="{StaticResource ChipLabelSelected}" Text="{Binding Dive.GasMix}" />
                            </Border>
                        </FlexLayout>
                        <FlexLayout
                            Wrap="Wrap" JustifyContent="Start" AlignItems="Center"
                            BindableLayout.ItemsSource="{Binding Dive.GearCsv, Converter={StaticResource CsvToList}}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                                        <Label Style="{StaticResource ChipLabel}" Text="{Binding .}" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        <Label
                            Style="{StaticResource Caption13}"
                            Text="{Binding Dive.BuddiesCsv, StringFormat='Buddies: {0}'}"
                            IsVisible="{Binding Dive.BuddiesCsv, Converter={StaticResource StringNotEmpty}}" />
                        <Label
                            Style="{StaticResource Body15}"
                            Text="{Binding Dive.Rating, Converter={StaticResource RatingToStars}}"
                            IsVisible="{Binding Dive.Rating, Converter={StaticResource IntGreaterThanZero}}"
                            TextColor="{AppThemeBinding Light={StaticResource LightWarn}, Dark={StaticResource Warn}}"
                            SemanticProperties.Description="{Binding Dive.Rating, Converter={StaticResource RatingToWords}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Notes. -->
                <Border Style="{StaticResource GlassCard}" IsVisible="{Binding Dive.Notes, Converter={StaticResource StringNotEmpty}}">
                    <VerticalStackLayout Spacing="{StaticResource CardSpacing}">
                        <Label Style="{StaticResource MonoLabel}" Text="NOTES" SemanticProperties.HeadingLevel="Level2" />
                        <Label Style="{StaticResource Body15}" Text="{Binding Dive.Notes}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Pinned primary pill — match this dive to a site in the atlas (OpenSiteCommand preserved). -->
        <Button
            Grid.Row="2"
            Style="{StaticResource PrimaryButton}"
            Text="Match the site →"
            Command="{Binding OpenSiteCommand}"
            Margin="24,12,24,20"
            SemanticProperties.Description="Match the site"
            SemanticProperties.Hint="Opens the dive site atlas to match this dive" />
    </Grid>
</ContentPage>
