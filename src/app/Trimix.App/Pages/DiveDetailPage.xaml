<?xml version="1.0" encoding="utf-8" ?>
<!-- Dive detail: shared PageHeader (← back + "Dive #N" title + origin chip) over a swipeable set of
     sections — Profile · Details · Events · Notes — with page dots beneath.

     The page used to be one long scroll of stacked cards, which reads as intimidating once a provider supplies
     real detail. Each section is its own ContentView (see Panes/) so the chart keeps real x:Name fields for its
     drawables and touch handling.

     Deliberately NOT a CarouselView. That control overrides each item's BindingContext with the item itself, so
     every view-model binding inside a pane silently resolved against a DivePaneKind enum — and a failed
     IsVisible binding falls back to true, which rendered empty cards. Setting the context back fought the
     control on every re-measure and ended in an ANR. Static siblings with one visible at a time also mean we own
     the swipe gesture, which makes scrub-vs-page arbitration free: a drag starting on a chart is consumed by
     that GraphicsView and never reaches these recognizers. -->
<controls:TrimixPage
    x:Class="Trimix.App.Pages.DiveDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Trimix.App.Controls"
    xmlns:panes="clr-namespace:Trimix.App.Panes"
    xmlns:vm="clr-namespace:Trimix.Core.ViewModels;assembly=Trimix.Core"
    xmlns:services="clr-namespace:Trimix.App.Services"
    x:DataType="vm:DiveDetailViewModel"
    Shell.PresentationMode="ModalAnimated"
    Shell.NavBarIsVisible="False"
    Title="Dive">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Shared header: ← back (CloseCommand) + "Dive #N" title + origin chip as the right action. -->
        <controls:PageHeader
            Grid.Row="0"
            Margin="24,8,24,0"
            Title="{Binding Title}"
            ShowBack="True"
            BackCommand="{Binding CloseCommand}">
            <controls:PageHeader.RightAction>
                <!-- Origin chip: the dive's source vendor (GARMIN / SUUNTO / …). -->
                <Border Style="{StaticResource BadgeMint}" VerticalOptions="Center"
                        SemanticProperties.Description="{Binding OriginLabel, StringFormat='Imported from {0}'}">
                    <Label Style="{StaticResource BadgeTextMint}" Text="{Binding OriginLabel}" />
                </Border>
            </controls:PageHeader.RightAction>
        </controls:PageHeader>


        <!-- Loading skeleton: the tile grid + chart card in outline, so the page holds its shape instead of
             showing a blank frame (or, before the IsLoaded gate, an unpopulated one) while the dive loads. -->
        <controls:SkeletonPanel Grid.Row="1" Margin="24,8" IsVisible="{Binding IsLoaded, Converter={StaticResource InverseBool}}">
            <VerticalStackLayout Spacing="{StaticResource SectionSpacing}" VerticalOptions="Start">
                <BoxView HeightRequest="11" WidthRequest="110" CornerRadius="3" Color="{StaticResource SurfaceRaised}" HorizontalOptions="Start" />
                <Grid RowDefinitions="*,*" ColumnDefinitions="*,*"
                      RowSpacing="{StaticResource CardSpacing}" ColumnSpacing="{StaticResource CardSpacing}">
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource GlassCard}" HeightRequest="96" />
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource GlassCard}" HeightRequest="96" />
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource GlassCard}" HeightRequest="96" />
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource GlassCard}" HeightRequest="96" />
                </Grid>
                <Border Style="{StaticResource GlassCard}" HeightRequest="330" />
            </VerticalStackLayout>
        </controls:SkeletonPanel>

        <!-- The sections. Exactly one is visible. The swipe recognizers live inside each pane's content stack,
             not here: on Android a ScrollView consumes the touch stream, so recognizers on an ancestor never
             fire. A drag starting on a chart is still consumed by that GraphicsView, so scrubbing never pages. -->
        <!-- Hidden until the view model has finished loading, then faded in by the code-behind. Without the
             gate the sections render against default state and the diver watches an empty skeleton pop into
             real data. -->
        <!-- Pane visibility is owned by the CODE-BEHIND, not by an Is*PaneVisible binding: a slide transition
             needs the outgoing and incoming panes visible at the SAME time, which mutually-exclusive bindings
             cannot express. The view model's Is*PaneVisible properties remain the semantic answer to "which
             section is current"; DiveDetailPage.ShowPane drives the actual visibility off CurrentPane.
             IsClippedToBounds is required — without it the sliding panes smear over the header and chips. -->
        <Grid Grid.Row="1" x:Name="Sections" IsVisible="{Binding IsLoaded}" IsClippedToBounds="True">
            <panes:ProfilePane x:Name="Profile" />
            <panes:DetailsPane x:Name="Details" IsVisible="False" />
            <panes:EventsPane x:Name="Events" IsVisible="False" />
            <panes:NotesPane x:Name="Notes" IsVisible="False" />
        </Grid>

        <!-- The section switcher chips were REMOVED: sections are changed by sliding, and each pane now
             carries its own heading so the current section is still named. The page dots below remain the
             position indicator. -->


        <!-- Page dots. The implicit IndicatorView style already gives GlassStroke dots with a mint selected
             dot. The counter announces "Section N of M" off the LIVE pane count, which varies per dive. -->
        <IndicatorView
            x:Name="PaneIndicator"
            Grid.Row="2"
            Margin="0,4,0,12"
            HorizontalOptions="Center"
            IndicatorSize="8"
            IsVisible="{Binding IsLoaded}"
            Count="{Binding PaneCount}"
            Position="{Binding PaneIndex}">
            <SemanticProperties.Description>
                <MultiBinding Converter="{StaticResource SectionCounter}">
                    <Binding Path="PaneIndex" />
                    <Binding Path="PaneCount" />
                </MultiBinding>
            </SemanticProperties.Description>
        </IndicatorView>
    </Grid>
</controls:TrimixPage>
