<?xml version="1.0" encoding="utf-8" ?>
<!-- "You" tab (prototype C8): shared PageHeader ("You", no action — the retired Settings page's
     privacy + about controls were folded in below). No profile/identity card — Trimix is
     single-device-per-user with no accounts, so there is no name/avatar/cert context to show ·
     plan card (Free "Keeps your last N dives" → Upgrade / Pro "Lifetime · unlimited import" ·
     Active) · UNITS toggle Metric|Imperial (re-renders depths/temps app-wide via the shared
     preference) · NITROX MOD PLANNER (pure display math — MOD = (1.4/FO₂ − 1) × 10 — never a deco
     engine; animated fill bar) · "Manage providers · N of 7 linked ›" · PRIVACY (export + factory
     reset) · ABOUT (disclaimer + replay onboarding). The glass cards/sliders stay (founder direction). -->
<controls:TrimixPage
    x:Class="Trimix.App.Pages.StatsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Trimix.Core.ViewModels;assembly=Trimix.Core"
    xmlns:controls="clr-namespace:Trimix.App.Controls"
    x:DataType="vm:StatsViewModel"
    Title="You">

    <!-- Header FIXED outside the scroll (matches every other page — the title/action must never
         scroll away); content scrolls beneath it. -->
    <Grid RowDefinitions="Auto,*">

        <!-- Shared header: tab page (no back, no action — Settings was retired into this surface). -->
        <controls:PageHeader Grid.Row="0" Margin="24,8,24,0" Title="You" />

    <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="{StaticResource PageContentPadding}" Spacing="{StaticResource SectionSpacing}">

            <!-- Plan card: Free (Keeps your last N dives · Upgrade) / Pro (Lifetime · Active). -->
            <Border Style="{StaticResource GlassCard}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsPro}" Value="True">
                        <Setter Property="Stroke" Value="{StaticResource SonarBrush}" />
                    </DataTrigger>
                </Border.Triggers>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label Style="{StaticResource Heading18}" FontSize="14" Text="{Binding PlanTitle}" />
                        <Label Style="{StaticResource Caption13}" FontSize="11" Text="{Binding PlanSub}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            Style="{StaticResource PrimaryButton}"
                            HeightRequest="36"
                            MinimumHeightRequest="36"
                            Padding="15,0"
                            FontSize="12"
                            Text="{Binding PlanCta}"
                            Command="{Binding PlanTapCommand}"
                            VerticalOptions="Center"
                            SemanticProperties.Description="{Binding PlanCta}"
                            SemanticProperties.Hint="Free plan: opens the one-time upgrade options" />
                </Grid>
            </Border>

            <!-- UNITS: Metric · m/°C | Imperial · ft/°F — re-renders depths and temps everywhere.
                 Selection colour is a live binding off IsMetric (UnitSegmentColorConverter) on the
                 UnitSegmentButton style — NOT a DataTrigger, which used to fight the Pressed
                 VisualState and leave both segments stuck mint after a switch-and-switch-back. -->
            <VerticalStackLayout Spacing="{StaticResource CardSpacing}">
                <Label Style="{StaticResource MonoLabel}" Text="UNITS" SemanticProperties.HeadingLevel="Level2" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            Style="{StaticResource UnitSegmentButton}"
                            Text="Metric · m / °C"
                            Command="{Binding SetMetricCommand}"
                            BorderColor="{Binding IsMetric, Converter={StaticResource UnitSegmentColor}, ConverterParameter=metric:border}"
                            TextColor="{Binding IsMetric, Converter={StaticResource UnitSegmentColor}, ConverterParameter=metric:text}"
                            SemanticProperties.Description="Metric units, metres and Celsius" />
                    <Button Grid.Column="1"
                            Style="{StaticResource UnitSegmentButton}"
                            Text="Imperial · ft / °F"
                            Command="{Binding SetImperialCommand}"
                            BorderColor="{Binding IsMetric, Converter={StaticResource UnitSegmentColor}, ConverterParameter=imperial:border}"
                            TextColor="{Binding IsMetric, Converter={StaticResource UnitSegmentColor}, ConverterParameter=imperial:text}"
                            SemanticProperties.Description="Imperial units, feet and Fahrenheit" />
                </Grid>
            </VerticalStackLayout>

            <!-- NITROX MOD PLANNER — pure display math over the dragged blend; NO deco engine, ever. -->
            <VerticalStackLayout Spacing="{StaticResource CardSpacing}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Style="{StaticResource MonoLabel}" Text="NITROX MOD PLANNER" SemanticProperties.HeadingLevel="Level2" />
                    <!-- Badge pops (scales up) while the slider is being dragged so the eye follows the
                         changing blend — code-behind animates on the Slider Drag started/completed. -->
                    <Border x:Name="EanBadge" Grid.Column="1" Style="{StaticResource BadgeMint}">
                        <Label Style="{StaticResource BadgeTextMint}" Text="{Binding EanLabel}" />
                    </Border>
                </Grid>
                <Label Style="{StaticResource Caption13}" Text="Drag to your blend — max operating depth at ppO₂ 1.4." />
                <Slider
                    Minimum="21"
                    Maximum="40"
                    Value="{Binding O2Percent}"
                    DragStarted="OnEanDragStarted"
                    DragCompleted="OnEanDragCompleted"
                    MinimumTrackColor="{AppThemeBinding Light={StaticResource LightSonarDeep}, Dark={StaticResource Sonar}}"
                    SemanticProperties.Description="{Binding EanLabel, StringFormat='Oxygen fraction {0}'}"
                    SemanticProperties.Hint="Sets the nitrox blend between 21 and 40 percent oxygen" />
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Style="{StaticResource MonoLabelDim}" Text="AIR 21%" TextTransform="None" />
                    <Label Grid.Column="1" Style="{StaticResource MonoLabelDim}" Text="40%" TextTransform="None" />
                </Grid>
                <HorizontalStackLayout Spacing="8" SemanticProperties.Description="{Binding ModText, StringFormat='Max operating depth {0}'}">
                    <Label Style="{StaticResource StatNumeral}" StyleClass="tnum" FontSize="26" Text="{Binding ModText}" AutomationProperties.IsInAccessibleTree="False" />
                    <Label Style="{StaticResource MonoLabelDim}" Text="MOD" VerticalOptions="End" Margin="0,0,0,4" AutomationProperties.IsInAccessibleTree="False" />
                </HorizontalStackLayout>
                <!-- Animated MOD fill bar (design: width tween .35s on O2 change — code-behind
                     drives ProgressTo from ModFillFraction; honors reduced motion). -->
                <ProgressBar
                    x:Name="ModFillBar"
                    ProgressColor="{AppThemeBinding Light={StaticResource LightSonarDeep}, Dark={StaticResource Sonar}}"
                    AutomationProperties.IsInAccessibleTree="False" />
            </VerticalStackLayout>

            <!-- Manage providers · N of 7 linked › -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="56"
                  SemanticProperties.Description="Manage providers"
                  SemanticProperties.Hint="Link or unlink your platforms">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ManageProvidersCommand}" />
                </Grid.GestureRecognizers>
                <Border Grid.Column="0" Style="{StaticResource BadgeMint}" WidthRequest="34" HeightRequest="34" VerticalOptions="Center"
                        AutomationProperties.IsInAccessibleTree="False">
                    <!-- Design's providers bubble: the sliders glyph, 16px. -->
                    <controls:AppIcon Icon="you" Size="16" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                    <Label Style="{StaticResource Heading18}" FontSize="14" Text="Manage providers" />
                    <Label Style="{StaticResource Caption13}" FontSize="11" Text="{Binding LinkedProvidersLabel}" />
                </VerticalStackLayout>
                <controls:AppIcon
                    Grid.Column="2"
                    Icon="chevron"
                    Size="16"
                    Color="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource TextSecondary}}"
                    VerticalOptions="Center"
                    AutomationProperties.IsInAccessibleTree="False" />
            </Grid>

            <!-- Privacy (serverless, on-device): local export + the single destructive factory reset.
                 Folded in from the retired Settings page. -->
            <Border Style="{StaticResource GlassCard}">
                <VerticalStackLayout Spacing="{StaticResource CardSpacing}">
                    <HorizontalStackLayout Spacing="6">
                        <controls:AppIcon Icon="lock" Size="13" VerticalOptions="Center" />
                        <Label Style="{StaticResource MonoLabel}" Text="PRIVACY" VerticalOptions="Center" SemanticProperties.HeadingLevel="Level2" />
                    </HorizontalStackLayout>
                    <Label
                        Style="{StaticResource Caption13}"
                        LineBreakMode="WordWrap"
                        Text="Everything lives on this device — there is no account and no server copy. Export gives you your dives as JSON; reset wipes this device entirely, including provider links." />
                    <Button
                        Style="{StaticResource SecondaryButton}"
                        Text="Export my data"
                        Clicked="OnExportClicked"
                        SemanticProperties.Description="Export my data"
                        SemanticProperties.Hint="Creates a JSON export of your dives and opens the share sheet" />
                    <Button
                        Style="{StaticResource DestructiveButton}"
                        Text="Reset app"
                        Command="{Binding ResetAppCommand}"
                        SemanticProperties.Description="Reset app"
                        SemanticProperties.Hint="Factory reset — erases all dives, provider links and settings on this device and restarts onboarding; asks for confirmation first" />
                </VerticalStackLayout>
            </Border>

            <!-- About: liability disclaimer (permanent non-goal — we never compute deco) + onboarding replay. -->
            <Border Style="{StaticResource GlassCard}">
                <VerticalStackLayout Spacing="{StaticResource CardSpacing}">
                    <Label Style="{StaticResource MonoLabel}" Text="ABOUT" SemanticProperties.HeadingLevel="Level2" />
                    <Label Style="{StaticResource Caption13}" LineBreakMode="WordWrap" Text="We log dives. We never compute decompression." />
                    <Button
                        Style="{StaticResource SecondaryButton}"
                        Text="Replay onboarding"
                        Command="{Binding ReplayOnboardingCommand}"
                        SemanticProperties.Description="Replay onboarding"
                        SemanticProperties.Hint="Runs the intro again — your dives and links stay put; handy for showing a friend" />
                </VerticalStackLayout>
            </Border>

            <!-- Bottom spacer so the last row clears the floating tab bar. -->
            <BoxView Color="Transparent" HeightRequest="{StaticResource TabScrollBottomInset}" />
        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</controls:TrimixPage>
