<?xml version="1.0" encoding="utf-8" ?>
<!-- Onboarding (prototype S1 + S2): 2-pane swipe carousel over full-bleed Abyss.
     S1 Welcome — TRIMIX wordmark, animated SonarPulse hero rings (design blePulse 164/3.2s),
     "Your logbook fills itself.", the auto-import promise, and the SYNCS WITH brand marquee
     auto-scrolling on the design's brandSlide 22s loop (code-behind; static under reduced motion).
     S2 "How it works" — the 3-step loop (01 Dive / 02 Sync / 03 Log) + "Continue" (→ biometric
     account step); its back affordance is the shared PageHeader ← (replaces the old ghost button).
     No Bluetooth copy anywhere: the app is serverless and API-sync-only. Every completion path
     fires first_run_completed via the VM. -->
<controls:TrimixPage
    x:Class="Trimix.App.Pages.OnboardingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Trimix.App.Controls"
    xmlns:vm="clr-namespace:Trimix.Core.ViewModels;assembly=Trimix.Core"
    x:DataType="vm:OnboardingViewModel"
    Shell.PresentationMode="Modal"
    Shell.NavBarIsVisible="False"
    Title="Welcome">

    <controls:TrimixPage.Resources>
        <!-- Carousel item = the pane index; content toggles off IntEquals against it. -->
        <x:Array x:Key="PaneIndices" Type="{x:Type x:Int32}">
            <x:Int32>0</x:Int32>
            <x:Int32>1</x:Int32>
        </x:Array>

        <!-- SYNCS WITH marquee entries (prototype order). -->
        <x:Array x:Key="MarqueeBrands" Type="{x:Type x:String}">
            <x:String>GARMIN DIVE</x:String>
            <x:String>SUUNTO</x:String>
            <x:String>SCUBAPRO</x:String>
            <x:String>MARES</x:String>
            <x:String>OCEANIC+</x:String>
            <x:String>PADI</x:String>
            <x:String>SSI</x:String>
        </x:Array>

        <!-- One marquee chip. The strip renders the brand list TWICE and translates by exactly half the
             total width to loop seamlessly. For that half to land copy B pixel-on where copy A was, the
             doubled row must be perfectly periodic — so the gap lives as a uniform TRAILING margin on
             every chip (incl. the last), and every Spacing is 0. Do not reintroduce StackLayout Spacing
             here: it would add a gap only *between* items, breaking the half-width periodicity. -->
        <DataTemplate x:Key="MarqueeChip" x:DataType="x:String">
            <Border Style="{StaticResource Chip}" Margin="0,0,8,0" AutomationProperties.IsInAccessibleTree="False">
                <Label
                    Style="{StaticResource BadgeText}"
                    Text="{Binding .}"
                    TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource TextSecondary}}" />
            </Border>
        </DataTemplate>
    </controls:TrimixPage.Resources>

    <Grid RowDefinitions="*,Auto" Padding="0,8,0,0">

        <!-- No header / back button anywhere in onboarding (founder 2026-07-29): the panes are reached
             by "Get started" / "Continue" and back-swipe on the carousel; there is nothing to go back to. -->

        <!-- ================= Swipe carousel: 2 panes ================= -->
        <CarouselView
            Grid.Row="0"
            ItemsSource="{StaticResource PaneIndices}"
            Position="{Binding PageIndex, Mode=TwoWay}"
            IndicatorView="{x:Reference pageIndicator}"
            Loop="False"
            HorizontalScrollBarVisibility="Never"
            VerticalScrollBarVisibility="Never">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="x:Int32">
                    <Grid>

                        <!-- ===== S1 · Welcome ===== -->
                        <Grid
                            Padding="24,0,24,8"
                            RowDefinitions="Auto,*,Auto"
                            IsVisible="{Binding ., Converter={StaticResource IntEquals}, ConverterParameter=0}">

                            <!-- Wordmark top-left + ANIMATED sonar hero in the top-right, fully inside
                                 the frame so the rings + FA emblem are never clipped (design: blePulse
                                 rings, 164px, 3.2s stagger). The box is sized to the max pulse extent
                                 (~190px) so the halo has room without spilling off-screen. -->
                            <Grid Grid.Row="0">
                                <!-- FROSTAURA maker eyebrow (grey mono, like the "HOW IT WORKS" label)
                                     sitting above the TRIMIX wordmark. -->
                                <VerticalStackLayout HorizontalOptions="Start" VerticalOptions="Start" Spacing="4">
                                    <Label Style="{StaticResource MonoLabel}" Text="FROSTAURA" />
                                    <Label Style="{StaticResource Wordmark}" Text="TRIMIX" FontSize="30" CharacterSpacing="5" />
                                </VerticalStackLayout>
                                <!-- The Trimix mark IS the sonar (blip + arcs pulsing outward) — no
                                     separate rings; the icon already carries the ping. -->
                                <controls:TrimixMark
                                    WidthRequest="96"
                                    HeightRequest="96"
                                    Margin="0,10,8,0"
                                    HorizontalOptions="End"
                                    VerticalOptions="Start"
                                    InputTransparent="True"
                                    AutomationProperties.IsInAccessibleTree="False" />
                            </Grid>

                            <!-- Headline + promise + SYNCS WITH marquee, pinned toward the bottom -->
                            <VerticalStackLayout Grid.Row="2" Spacing="16">
                                <Label
                                    Style="{StaticResource Display32}"
                                    Text="Your logbook&#10;fills itself."
                                    HorizontalTextAlignment="Start"
                                    SemanticProperties.HeadingLevel="Level1" />
                                <Label
                                    Style="{StaticResource Body15}"
                                    Text="Auto-import from every dive computer you own — and keep PADI, SSI and your other dive apps in sync, automatically."
                                    TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource TextSecondary}}"
                                    HorizontalTextAlignment="Start" />

                                <!-- SYNCS WITH brand marquee: continuous 22s brandSlide auto-scroll
                                     (code-behind); the track holds the brand row TWICE so a half-width
                                     translate loops seamlessly. Static row under reduced motion. -->
                                <VerticalStackLayout Spacing="10" Margin="0,4,0,0">
                                    <Label Style="{StaticResource MonoLabel}" Text="SYNCS WITH" Margin="0" />
                                    <Grid
                                        HeightRequest="34"
                                        Margin="-24,0"
                                        IsClippedToBounds="True"
                                        SemanticProperties.Description="Syncs with Garmin Dive, Suunto, ScubaPro, Mares, Oceanic plus, PADI and SSI">
                                        <HorizontalStackLayout
                                            Spacing="0"
                                            HorizontalOptions="Start"
                                            VerticalOptions="Center"
                                            Loaded="OnMarqueeLoaded"
                                            Unloaded="OnMarqueeUnloaded">
                                            <HorizontalStackLayout Spacing="0" BindableLayout.ItemsSource="{StaticResource MarqueeBrands}" BindableLayout.ItemTemplate="{StaticResource MarqueeChip}" />
                                            <HorizontalStackLayout Spacing="0" BindableLayout.ItemsSource="{StaticResource MarqueeBrands}" BindableLayout.ItemTemplate="{StaticResource MarqueeChip}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- ===== S2 · How it works — the 3-step loop (GlassCards). No back button:
                             onboarding is reached by "Get started"/"Continue" + back-swipe only. ===== -->
                        <VerticalStackLayout
                            Padding="24,0"
                            Spacing="{StaticResource CardSpacing}"
                            VerticalOptions="Center"
                            IsVisible="{Binding ., Converter={StaticResource IntEquals}, ConverterParameter=1}">
                            <Label Style="{StaticResource MonoLabel}" Text="HOW IT WORKS" />
                            <Label
                                Style="{StaticResource Title24}"
                                Text="The loop"
                                Margin="0,0,0,10"
                                SemanticProperties.HeadingLevel="Level1" />

                            <Border Style="{StaticResource GlassCard}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                    <Label Grid.Column="0" Style="{StaticResource MonoIndex}" Text="01" VerticalOptions="Start" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource TightSpacing}">
                                        <Label Style="{StaticResource Heading18}" Text="Dive" />
                                        <Label
                                            Style="{StaticResource Body15}"
                                            Text="Your computer records the profile and uploads to its own platform, as always."
                                            TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource TextSecondary}}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource GlassCard}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                    <Label Grid.Column="0" Style="{StaticResource MonoIndex}" Text="02" VerticalOptions="Start" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource TightSpacing}">
                                        <Label Style="{StaticResource Heading18}" Text="Sync" />
                                        <Label
                                            Style="{StaticResource Body15}"
                                            Text="Link your computer providers once — dives flow in on their own."
                                            TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource TextSecondary}}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource GlassCard}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                    <Label Grid.Column="0" Style="{StaticResource MonoIndex}" Text="03" VerticalOptions="Start" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource TightSpacing}">
                                        <Label Style="{StaticResource Heading18}" Text="Log" />
                                        <Label
                                            Style="{StaticResource Body15}"
                                            Text="Every dive lands in your logbook — origin, sync status and profile, laid out beautifully."
                                            TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource TextSecondary}}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                    </Grid>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <!-- ================= Bottom action zone (per-pane CTAs + dots) ================= -->
        <VerticalStackLayout Grid.Row="1" Padding="24,12,24,32" Spacing="{StaticResource SectionSpacing}">

            <IndicatorView
                x:Name="pageIndicator"
                HorizontalOptions="Center"
                IndicatorSize="8"
                SemanticProperties.Description="{Binding PageIndex, Converter={StaticResource PageCounter}}" />

            <!-- Pane 1 (Welcome) actions — a single path (no accounts, nothing to sign in to). -->
            <VerticalStackLayout
                Spacing="{StaticResource TightSpacing}"
                IsVisible="{Binding PageIndex, Converter={StaticResource IntEquals}, ConverterParameter=0}">
                <Button
                    Style="{StaticResource PrimaryButton}"
                    Text="Get started"
                    Command="{Binding NextCommand}"
                    SemanticProperties.Description="Get started"
                    SemanticProperties.Hint="Shows how automatic sync works" />
            </VerticalStackLayout>

            <!-- Pane 2 (How it works) actions — back lives in the shared header now. -->
            <VerticalStackLayout
                Spacing="{StaticResource TightSpacing}"
                IsVisible="{Binding PageIndex, Converter={StaticResource IntEquals}, ConverterParameter=1}">
                <Button
                    Style="{StaticResource PrimaryButton}"
                    Text="Continue"
                    Command="{Binding NextCommand}"
                    SemanticProperties.Description="Continue"
                    SemanticProperties.Hint="Advances to the account step" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Grid>
</controls:TrimixPage>
