<?xml version="1.0" encoding="utf-8" ?>
<!-- Provider sign-in: a TRIMIX screen that collects the diver's provider credentials.

     This page used to imitate an in-app browser showing the vendor's website — a padlock beside
     "{provider}.com", a browser refresh glyph, and a forced-light "web page" viewport, captioned "This is
     {Provider}'s own sign-in page". None of that was true: it is a native form in Trimix's own process, and the
     credentials go straight into the connector. Beyond being dishonest, asserting a padlock and a domain for an
     origin the user is not connected to is a misrepresentation of origin (passing off), the kind of deceptive
     presentation both app stores prohibit, and visually indistinguishable from credential phishing. The
     connector layer already states plainly that this is NOT an official vendor integration; this screen now
     agrees with it.

     When provider sign-in moves into a WebView loading the vendor's real page, browser chrome becomes accurate
     and can legitimately return — driven by the WebView's actual URL, never a hard-coded string.

     The VM owns the guardrail chain: disclosure → consent → one-shot credential exchange (token only, never the
     password) → first-link auto-sync. -->
<controls:TrimixPage
    x:Class="Trimix.App.Pages.ProviderOAuthPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Trimix.App.Controls"
    xmlns:vm="clr-namespace:Trimix.Core.ViewModels;assembly=Trimix.Core"
    x:DataType="vm:ProviderOAuthViewModel"
    Shell.PresentationMode="ModalAnimated"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource Abyss}"
    Title="Provider sign-in">

    <Grid RowDefinitions="Auto,*">

        <!-- Sheet chrome: ← close + an honest title naming the app doing the asking. Deliberately NOT a
             padlock and a domain: that pairing is the browser's assertion of an authenticated connection to an
             origin, and this is a Trimix form. -->
        <Grid Grid.Row="0" ColumnDefinitions="44,*,44" Margin="12,8,12,8" ColumnSpacing="8">
            <Grid
                Grid.Column="0"
                WidthRequest="44"
                HeightRequest="44"
                SemanticProperties.Description="Close sign-in"
                SemanticProperties.Hint="Closes the provider sign-in without connecting">
                <controls:AppIcon Icon="back" Size="22" HorizontalOptions="Center" VerticalOptions="Center" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseCommand}" />
                </Grid.GestureRecognizers>
            </Grid>
            <Label
                Grid.Column="1"
                Style="{StaticResource MonoLabel}"
                Text="{Binding SheetTitle}"
                TextColor="{StaticResource TextPrimary}"
                LineBreakMode="TailTruncation"
                HorizontalTextAlignment="Center"
                VerticalOptions="Center" />
        </Grid>

        <!-- An ordinary Trimix surface. It used to be forced light with hard-coded vendor-ish colours purely
             so it would read as a different website. -->
        <Border
            Grid.Row="1"
            Margin="0"
            Padding="0"
            StrokeThickness="0"
            Background="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource Surface}}"
            StrokeShape="RoundRectangle 18,18,0,0">
            <ScrollView>
                <VerticalStackLayout Padding="26,30,26,30" Spacing="14">

                    <!-- Monogram placeholder — never a claimed official vendor mark. -->
                    <Border
                        WidthRequest="46"
                        HeightRequest="46"
                        StrokeShape="RoundRectangle 12"
                        Style="{StaticResource GlassCard}"
                        Padding="0"
                        HorizontalOptions="Start"
                        AutomationProperties.IsInAccessibleTree="False">
                        <Label
                            Text="{Binding Monogram}"
                            FontFamily="SpaceGroteskBold"
                            FontSize="20"
                            TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource TextPrimary}}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <Label
                        Style="{StaticResource Title24}"
                        FontSize="22"
                        Text="{Binding SignInHeading}"
                        SemanticProperties.HeadingLevel="Level1" />

                    <Label Style="{StaticResource Caption13}" LineBreakMode="WordWrap" Text="{Binding SignInCaption}" />

                    <!-- Credential fields (fed ONCE into the connector; password never persisted) -->
                    <Border Style="{StaticResource InputField}">
                        <Entry
                            Text="{Binding Username}"
                            Placeholder="Email or username"
                            Keyboard="Email"
                            BackgroundColor="Transparent"
                            SemanticProperties.Description="Provider account email or username" />
                    </Border>
                    <Border Style="{StaticResource InputField}">
                        <Entry
                            Text="{Binding Password}"
                            Placeholder="Password"
                            IsPassword="True"
                            BackgroundColor="Transparent"
                            SemanticProperties.Description="Provider account password" />
                    </Border>

                    <Button
                        Text="Sign in &amp; authorize"
                        Style="{StaticResource PrimaryButton}"
                        MinimumHeightRequest="52"
                        Margin="0,6,0,0"
                        Command="{Binding SignInAndAuthorizeCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        SemanticProperties.Description="Sign in and authorize"
                        SemanticProperties.Hint="Signs in to the provider and authorizes read-only access" />

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        HorizontalOptions="Center"
                        SemanticProperties.Description="Signing in" />

                    <Label
                        Style="{StaticResource Caption13}"
                        Text="Read-only access · disconnect anytime."
                        HorizontalTextAlignment="Center"
                        Margin="0,8,0,0" />
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</controls:TrimixPage>
