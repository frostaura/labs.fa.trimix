<?xml version="1.0" encoding="utf-8" ?>
<!-- Sites (PRD Flow C read path; design doc): search field + list with name, type, depth range
     and distance from the device. No map control in the slice (architecture §10). -->
<ContentPage
    x:Class="Trimix.App.Pages.SitesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Trimix.Core.ViewModels;assembly=Trimix.Core"
    xmlns:dtos="clr-namespace:Trimix.Contracts.Dtos;assembly=Trimix.Contracts"
    x:DataType="vm:SitesViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource LightAbyss}, Dark={StaticResource Abyss}}"
    Title="Sites">

    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="0">

        <!-- Header: mono eyebrow + big screen title -->
        <VerticalStackLayout Grid.Row="0" Margin="24,16,24,8" Spacing="{StaticResource TightSpacing}">
            <Label Style="{StaticResource MonoLabel}" Text="DIVE-SITE ATLAS" />
            <Label Style="{StaticResource Title24}" Text="Sites" />
        </VerticalStackLayout>

        <!-- Flat search: magnifier glyph + Entry (no native SearchBar chrome / filled box), aligned to
             the page's 24px gutter. -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="24,4,24,10" VerticalOptions="Center">
            <Label
                Grid.Column="0"
                Text="⌕"
                FontSize="22"
                VerticalOptions="Center"
                TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource TextSecondary}}"
                AutomationProperties.IsInAccessibleTree="False" />
            <Entry
                Grid.Column="1"
                Placeholder="Search dive sites"
                Text="{Binding Query}"
                ReturnCommand="{Binding SearchCommand}"
                SemanticProperties.Description="Site search"
                SemanticProperties.Hint="Searches the shared dive-site database; nearby sites rank first" />
        </Grid>

        <!-- Offline banner: icon + words + retry (never color-only). -->
        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Margin="24,4" IsVisible="{Binding IsOffline}">
            <VerticalStackLayout Spacing="{StaticResource CardSpacing}">
                <Label Style="{StaticResource Body15}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="⚠ " TextColor="{AppThemeBinding Light={StaticResource LightWarn}, Dark={StaticResource Warn}}" />
                            <Span Text="Offline — the shared site database is unreachable right now." />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Button
                    Style="{StaticResource SecondaryButton}"
                    Text="Try again"
                    Command="{Binding SearchCommand}"
                    SemanticProperties.Description="Retry site search" />
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="3">
            <CollectionView ItemsSource="{Binding Sites}" SelectionMode="None" Margin="24,4,24,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:SiteSummaryDto">
                        <Border
                            Style="{StaticResource GlassCard}"
                            Margin="0,6"
                            SemanticProperties.Description="{Binding Name}"
                            SemanticProperties.Hint="Opens this dive site's details">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding OpenSiteCommand, Source={RelativeSource AncestorType={x:Type vm:SitesViewModel}}, x:DataType=vm:SitesViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="48" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="{StaticResource TightSpacing}" VerticalOptions="Center">
                                    <Label Style="{StaticResource MonoLabel}" Text="SITE" />
                                    <Label Style="{StaticResource Heading18}" Text="{Binding Name}" />
                                    <Label Style="{StaticResource Caption13}" Text="{Binding ., Converter={StaticResource SiteSubtitle}}" />
                                </VerticalStackLayout>
                                <Label
                                    Grid.Column="1"
                                    Style="{StaticResource Heading18}"
                                    Text="›"
                                    VerticalOptions="Center"
                                    AutomationProperties.IsInAccessibleTree="False"
                                    TextColor="{AppThemeBinding Light={StaticResource LightSonarDeep}, Dark={StaticResource Sonar}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label
                        Style="{StaticResource Caption13}"
                        HorizontalTextAlignment="Center"
                        Margin="0,32"
                        Text="No sites found. Try a name, or clear the search to see sites near you." />
                </CollectionView.EmptyView>
                <!-- Bottom spacer so the last site scrolls clear of / under the floating iOS tab bar. -->
                <CollectionView.Footer>
                    <BoxView Color="Transparent" HeightRequest="{StaticResource TabScrollBottomInset}" />
                </CollectionView.Footer>
            </CollectionView>

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                SemanticProperties.Description="Searching sites" />
        </Grid>
    </Grid>
</ContentPage>
