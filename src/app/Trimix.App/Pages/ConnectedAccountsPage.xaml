<?xml version="1.0" encoding="utf-8" ?>
<!-- Providers (prototype S5): one row per registered connector — Garmin Dive · Suunto · ScubaPro ·
     Mares · Oceanic+ then PADI · SSI — states Not connected → Linked ✓ / Syncing…. Shared
     foundation: TrimixPage (screenIn), PageHeader with the ← back this pushed page previously
     lacked, and the animated SonarPulse radar (design blePulse, gated on any linked provider) as
     the header's RightAction. Connect pushes the provider's own in-app sign-in sheet; arriving via
     an unlinked "Sync now" pulses the Connect buttons red (connectNudge, animated in code-behind).
     Rows stagger in per the design's rowIn. Tapping a linked row offers unlink (revoke anytime). -->
<controls:TrimixPage
    x:Class="Trimix.App.Pages.ConnectedAccountsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Trimix.App.Controls"
    xmlns:vm="clr-namespace:Trimix.Core.ViewModels;assembly=Trimix.Core"
    x:DataType="vm:ConnectedAccountsViewModel"
    Title="Providers">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="24,8,24,0">

        <!-- Shared header: pushed page ⇒ ← back only. The radar "Sync now" button was removed from
             every page's top-right — the add sheet's "Sync now" row is the single entry point now. -->
        <controls:PageHeader Grid.Row="0" Title="Providers" ShowBack="True" />

        <!-- Caption: width-bounded + wrapping so it can never clip off-screen. -->
        <Label
            Grid.Row="1"
            Style="{StaticResource Caption13}"
            LineBreakMode="WordWrap"
            Text="Your phone syncs each platform directly — links stay on-device." />

        <!-- Last-sync label (design: right-aligned mono microcopy under the radar). -->
        <Label
            Grid.Row="2"
            Style="{StaticResource MonoLabelDim}"
            Text="{Binding Sync.LastSyncLabel}"
            HorizontalOptions="End"
            Margin="0,6,2,4" />

        <!-- Provider rows (BindableLayout so the rowIn stagger + connectNudge can address rows). -->
        <ScrollView Grid.Row="3">
            <VerticalStackLayout>
                <VerticalStackLayout x:Name="RowsHost" Margin="0,4,0,0" BindableLayout.ItemsSource="{Binding Providers}">
                    <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProviderRow">
                        <Border Style="{StaticResource GlassCard}" Margin="0,6">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                                <!-- Monogram "logo" box -->
                                <Border
                                    Grid.Column="0"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="{AppThemeBinding Light={StaticResource LightGlassStroke}, Dark={StaticResource GlassStroke}}"
                                    Background="{AppThemeBinding Light={StaticResource LightSurfaceRaisedBrush}, Dark={StaticResource SurfaceRaisedBrush}}"
                                    VerticalOptions="Center"
                                    AutomationProperties.IsInAccessibleTree="False">
                                    <Label
                                        Style="{StaticResource Heading18}"
                                        Text="{Binding Monogram}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Border>

                                <!-- Name + status (star column ⇒ truncates instead of pushing the CTA off-screen) -->
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Style="{StaticResource Heading18}" Text="{Binding PlatformName}" LineBreakMode="TailTruncation" />
                                    <Label Style="{StaticResource Caption13}" Text="{Binding StatusText}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>

                                <!-- CTA: Connect (nudge-able; ClassId lets the code-behind run the
                                     connectNudge color pulse) / Linked ✓ (tap to unlink). -->
                                <Button
                                    Grid.Column="2"
                                    ClassId="ConnectCta"
                                    Style="{StaticResource SecondaryButton}"
                                    Text="{Binding CtaText}"
                                    VerticalOptions="Center"
                                    Command="{Binding ConnectCommand, Source={RelativeSource AncestorType={x:Type vm:ConnectedAccountsViewModel}}, x:DataType=vm:ConnectedAccountsViewModel}"
                                    CommandParameter="{Binding .}"
                                    SemanticProperties.Description="{Binding PlatformName, StringFormat='Connect or unlink {0}'}"
                                    SemanticProperties.Hint="Opens the provider's own sign-in, or unlinks it">
                                    <Button.Triggers>
                                        <!-- Linked: quiet mint pill -->
                                        <DataTrigger TargetType="Button" Binding="{Binding IsLinked}" Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightSonar}, Dark={StaticResource Sonar}}" />
                                            <Setter Property="BorderColor" Value="Transparent" />
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurfaceRaised}, Dark={StaticResource SurfaceRaised}}" />
                                        </DataTrigger>
                                        <!-- Unlinked: mint outline (the nudge animation pulses it red) -->
                                        <DataTrigger TargetType="Button" Binding="{Binding IsLinked}" Value="False">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightSonar}, Dark={StaticResource Sonar}}" />
                                            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource LightSonar}, Dark={StaticResource Sonar}}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Bottom spacer so the last row scrolls clear of the floating tab bar. -->
                <BoxView Color="Transparent" HeightRequest="{StaticResource TabScrollBottomInset}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</controls:TrimixPage>
