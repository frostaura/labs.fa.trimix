<?xml version="1.0" encoding="utf-8" ?>
<!-- Settings → Connected accounts (aggregator activation UI, Slice 2). A registry-driven list over every
     self-registered connector: name + legal-posture badge + fidelity caption + connect/disconnect for the
     reverse-engineered "personal export" connectors. Connect shows the connector's own ToS-risk disclosure
     (via the VM's ConfirmAsync) and only then reveals a credential sheet that feeds the password once into
     the connector (never persisted). An SSI card renders the diver-scanned MySSI QR when produced. Pushed
     route (Shell provides the back arrow). Sonar styling per docs/design/mockup-spec.md. -->
<ContentPage
    x:Class="Trimix.App.Pages.ConnectedAccountsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Trimix.Core.ViewModels;assembly=Trimix.Core"
    x:DataType="vm:ConnectedAccountsViewModel"
    Title="Connected accounts">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PageContentPadding}" Spacing="{StaticResource SectionSpacing}">

            <Label
                Style="{StaticResource Title24}"
                Text="Connected accounts"
                Margin="0,4,0,0"
                SemanticProperties.HeadingLevel="Level1" />
            <Label
                Style="{StaticResource Caption13}"
                Text="Your dive computer over Bluetooth and standard file imports are always available. The unofficial 'personal export' connectors sign in to your own vendor account to pull your dives — they are not official integrations, so read the notice before connecting." />

            <!-- Connector registry -->
            <CollectionView ItemsSource="{Binding Connectors}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConnectorRow">
                        <Border Style="{StaticResource GlassCard}" Margin="0,6">
                            <VerticalStackLayout Spacing="{StaticResource CardSpacing}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Label
                                        Grid.Column="0"
                                        Style="{StaticResource Heading18}"
                                        Text="{Binding DisplayName}"
                                        VerticalOptions="Center" />
                                    <Border Grid.Column="1" Style="{StaticResource BadgeMint}">
                                        <Label Style="{StaticResource BadgeTextMint}" Text="{Binding LegalBadge}" />
                                    </Border>
                                </Grid>

                                <Label Style="{StaticResource Caption13}" Text="{Binding FidelityCaption}" />

                                <!-- ToS-risk notice, shown only for the unofficial reverse-engineered connectors. -->
                                <Label
                                    Style="{StaticResource Caption13}"
                                    TextColor="{AppThemeBinding Light={StaticResource LightWarn}, Dark={StaticResource Warn}}"
                                    IsVisible="{Binding IsReverseEng}"
                                    Text="⚠ Unofficial personal export — may breach the vendor's Terms of Service. Your password is used once to obtain a token and is never stored." />

                                <Label
                                    Style="{StaticResource MonoLabelMint}"
                                    Text="{Binding StatusMessage}"
                                    IsVisible="{Binding IsManaged}" />

                                <Button
                                    Style="{StaticResource SecondaryButton}"
                                    Text="Connect"
                                    IsVisible="{Binding CanConnect}"
                                    Command="{Binding ConnectCommand, Source={RelativeSource AncestorType={x:Type vm:ConnectedAccountsViewModel}}, x:DataType=vm:ConnectedAccountsViewModel}"
                                    CommandParameter="{Binding .}"
                                    SemanticProperties.Description="{Binding DisplayName, StringFormat='Connect {0}'}"
                                    SemanticProperties.Hint="Shows the personal-export notice, then a sign-in sheet" />
                                <Button
                                    Style="{StaticResource GhostButton}"
                                    Text="Disconnect"
                                    IsVisible="{Binding CanDisconnect}"
                                    Command="{Binding DisconnectCommand, Source={RelativeSource AncestorType={x:Type vm:ConnectedAccountsViewModel}}, x:DataType=vm:ConnectedAccountsViewModel}"
                                    CommandParameter="{Binding .}"
                                    SemanticProperties.Description="{Binding DisplayName, StringFormat='Disconnect {0}'}"
                                    SemanticProperties.Hint="Revokes consent and deletes the stored access token" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Credential sign-in sheet (inline, revealed after consent). -->
            <Border Style="{StaticResource GlassCard}" IsVisible="{Binding IsCredentialSheetVisible}">
                <VerticalStackLayout Spacing="{StaticResource CardSpacing}">
                    <Label Style="{StaticResource MonoLabel}" Text="SIGN IN" SemanticProperties.HeadingLevel="Level2" />
                    <Label
                        Style="{StaticResource Body15}"
                        Text="{Binding ActiveCredentialRow.DisplayName, StringFormat='Sign in to {0}'}" />
                    <Entry
                        Text="{Binding CredentialUsername}"
                        Placeholder="Email or username"
                        Keyboard="Email"
                        SemanticProperties.Description="Account email or username" />
                    <Entry
                        Text="{Binding CredentialPassword}"
                        Placeholder="Password"
                        IsPassword="True"
                        SemanticProperties.Description="Account password" />
                    <Label
                        Style="{StaticResource Caption13}"
                        Text="Your password is sent once to obtain an access token and is never stored on this device." />
                    <Button
                        Text="Connect"
                        Command="{Binding SubmitCredentialsCommand}"
                        CommandParameter="{Binding ActiveCredentialRow}"
                        SemanticProperties.Description="Sign in and connect"
                        SemanticProperties.Hint="Exchanges your credentials for an access token" />
                    <Button
                        Style="{StaticResource GhostButton}"
                        Text="Cancel"
                        Command="{Binding CancelCredentialsCommand}"
                        SemanticProperties.Description="Cancel sign-in" />
                </VerticalStackLayout>
            </Border>

            <!-- Diver-scanned MySSI QR export (rendered when a dive is supplied). -->
            <Border Style="{StaticResource GlassCard}" IsVisible="{Binding HasSsiQr}">
                <VerticalStackLayout Spacing="{StaticResource CardSpacing}">
                    <Label Style="{StaticResource MonoLabel}" Text="MYSSI QR EXPORT" SemanticProperties.HeadingLevel="Level2" />
                    <Label
                        Style="{StaticResource Caption13}"
                        Text="Scan this in your own logged-in MySSI app to add the dive. Summary only (date, duration, max depth); no server contact, no credentials." />
                    <GraphicsView
                        x:Name="QrView"
                        HeightRequest="240"
                        WidthRequest="240"
                        HorizontalOptions="Center"
                        SemanticProperties.Description="MySSI dive export QR code" />
                    <Label
                        Style="{StaticResource Caption13}"
                        Text="{Binding SsiQrPayload}"
                        LineBreakMode="CharacterWrap" />
                </VerticalStackLayout>
            </Border>

            <!-- Bottom spacer so the last card clears the floating tab bar / home indicator. -->
            <BoxView Color="Transparent" HeightRequest="{StaticResource TabScrollBottomInset}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
