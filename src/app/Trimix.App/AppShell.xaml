<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Trimix.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Trimix.App.Pages"
    Title="Trimix">

    <!-- Mockup tab bar: three tabs — Log · Sites · You. Import is NOT a tab; it's a flow pushed
         from the Logbook ("Import from computer"), reached via the registered `import` route (see
         AppShell.xaml.cs). "You" is the career-analytics StatsPage (aggregator architecture §8.5);
         Settings surfaces behind its gear as a pushed `settings` route. Modal/pushed routes
         (onboarding, auth, import, manual-entry, dive-detail, site-detail, contribute, paywall,
         settings) register in AppShell.xaml.cs against Core's Routes constants. -->
    <TabBar>
        <ShellContent
            Title="Log"
            Icon="tab_logbook.png"
            ContentTemplate="{DataTemplate pages:LogbookPage}"
            Route="logbook" />
        <ShellContent
            Title="Sites"
            Icon="tab_sites.png"
            ContentTemplate="{DataTemplate pages:SitesPage}"
            Route="sites" />
        <!-- "You" uses the design's sliders glyph (tab_you.svg), not the old settings icon. -->
        <ShellContent
            Title="You"
            Icon="tab_you.png"
            ContentTemplate="{DataTemplate pages:StatsPage}"
            Route="stats" />
    </TabBar>

</Shell>
