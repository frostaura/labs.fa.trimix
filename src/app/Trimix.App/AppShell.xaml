<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Trimix.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Trimix.App.Pages"
    Title="Trimix">

    <!-- Tab bar: two tabs — Log · You. Trimix is a logbook + sync tool; the Sites capability was
         removed 2026-07-29. Import is NOT a tab; it's a flow pushed from the Logbook. "You" is the
         career-analytics StatsPage (aggregator architecture §8.5). Pushed routes (onboarding,
         dive-detail, paywall, providers, provider-oauth) register in AppShell.xaml.cs. -->
    <TabBar>
        <ShellContent
            Title="Log"
            Icon="tab_logbook.png"
            ContentTemplate="{DataTemplate pages:LogbookPage}"
            Route="logbook" />
        <!-- "You" uses the design's sliders glyph (tab_you.svg), not the old settings icon. -->
        <ShellContent
            Title="You"
            Icon="tab_you.png"
            ContentTemplate="{DataTemplate pages:StatsPage}"
            Route="stats" />
    </TabBar>

</Shell>
