<?xml version="1.0" encoding="utf-8"?>
<!--
    Native Android chrome colors = Sonar tokens (docs/design/mockup-spec.md, storyboard-exact), NOT the
    MAUI template purple. These drive native surfaces the design system does not paint directly:
    native dialogs (DatePicker/TimePicker, DisplayAlert), text-selection handles, the status bar.
    - colorPrimary / colorPrimaryDark = Abyss #0A1013 (seamless dark chrome + status bar).
    - colorAccent = Sonar mint #2FE3C4 (primary accent: selection, dialog buttons).
-->
<resources>
    <color name="colorPrimary">#0A1013</color>
    <color name="colorPrimaryDark">#0A1013</color>
    <color name="colorAccent">#2FE3C4</color>
</resources>
