{
  // ── Trimix client configuration — DEPLOY INPUTS ──────────────────────────────────────────────
  // This asset ships with safe DEV defaults. A deployer edits THIS FILE (no code change) and rebuilds
  // the app package to supply real values. Everything here is non-secret plumbing; real secrets/tokens
  // are NEVER committed. Comments and trailing commas are tolerated by the parser (ClientConfigBinder).

  "Connectors": {
    // Reverse-engineered personal-export endpoints. These ship NULL so the dark connectors stay dark and
    // report Unsupported. Populate ONLY after legal/BD sign-off — never commit a real endpoint here.
    "Padi": { "AuthUrl": null, "PushUrl": null },
    "Ssi": { "AuthUrl": null, "PushUrl": null },
    "Cloud": {
      "Garmin": { "AuthUrl": null, "TokenUrl": null, "ListUrl": null, "DownloadUrl": null },
      "Suunto": { "AuthUrl": null, "TokenUrl": null, "ListUrl": null, "DownloadUrl": null },
      "Oceanic": { "AuthUrl": null, "TokenUrl": null, "ListUrl": null, "DownloadUrl": null },
      // Shared MySSI (DiveSSI) READ corridor feeding BOTH the Mares and ScubaPro sources (neither vendor
      // has a cloud of its own). AuthUrl = login; ListUrl = logbook list/detail base. Null keeps the
      // in-source researched-guess constants in force.
      "MySsi": { "AuthUrl": null, "ListUrl": null }
    }
  },

  "Features": {
    // Master switches for the reverse-engineered connector families. ON since the serverless rebuild made
    // the connectors the primary product surface (founder-directed promotion, recorded in MEMORY.md). Every
    // connector still ships with a dark descriptor (EnabledByDefault=false) and does ZERO network I/O until
    // the user opts in behind its plain-language ToS-risk disclosure — these switches remain the deploy
    // kill-switch that unregisters a family entirely.
    "EnableCloudConnectors": true,
    "EnablePushConnectors": true
  }
}
