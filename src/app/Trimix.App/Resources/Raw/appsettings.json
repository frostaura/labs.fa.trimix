{
  // ── Trimix client configuration — DEPLOY INPUTS ──────────────────────────────────────────────
  // This asset ships with safe DEV defaults. A deployer edits THIS FILE (no code change) and rebuilds
  // the app package to supply real values. Everything here is non-secret plumbing; real secrets/tokens
  // are NEVER committed. Comments and trailing commas are tolerated by the parser (ClientConfigBinder).

  "Api": {
    // DEPLOY INPUT: real API base URL. Release target is "https://api.trimix.frostaura.net", pending
    // name clearance + TLS provisioning. Null/omitted keeps the built-in TrimixCoreOptions dev default.
    "BaseUrl": "http://localhost:5210"
  },

  "Connectors": {
    // Reverse-engineered personal-export endpoints. These ship NULL so the dark connectors stay dark and
    // report Unsupported. Populate ONLY after legal/BD sign-off — never commit a real endpoint here.
    "Padi": { "AuthUrl": null, "PushUrl": null },
    "Ssi": { "AuthUrl": null, "PushUrl": null },
    "Cloud": {
      "Garmin": { "AuthUrl": null, "TokenUrl": null, "ListUrl": null, "DownloadUrl": null },
      "Suunto": { "AuthUrl": null, "TokenUrl": null, "ListUrl": null, "DownloadUrl": null },
      "Oceanic": { "AuthUrl": null, "TokenUrl": null, "ListUrl": null, "DownloadUrl": null }
    }
  },

  // Per-vendor BLE GATT UUID overrides, keyed by vendor name. Absent ⇒ the in-source BLE profile is used.
  // DEPLOY INPUT: add a vendor entry ONLY with UUIDs / handshake bytes verified against real hardware —
  // never a guessed identifier. Example shape (values intentionally omitted; do NOT invent them):
  //   "Shearwater": { "ServiceUuid": "", "WriteCharUuid": "", "NotifyCharUuid": "", "HandshakeCommandsHex": "" }
  "Ble": {},

  "Features": {
    // Master switches for the reverse-engineered connector families. OFF until legal sign-off — this is a
    // deploy gate ON TOP OF the per-connector consent gate, not a replacement for it.
    "EnableCloudConnectors": false,
    "EnablePushConnectors": false
  }
}
