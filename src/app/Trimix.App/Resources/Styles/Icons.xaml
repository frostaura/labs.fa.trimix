<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Trimix icon set — named SVG path data (24x24 viewbox), extracted 1:1 from the authoritative
    interactive design (Interactive.dc.html) where the design draws the glyph, and drawn in the same
    language (stroke ~1.6, round caps/joins, mint) where the design uses a text glyph. Rendered by
    Controls/AppIcon.cs (which resolves "sync" -> "IconSync"); never render emoji glyphs again.

    RULE: every path command is EXPLICIT (each segment carries its own letter — "M 3 18 L 9 11",
    never SVG's implicit repeats "M 3 18 9 11"). Maui.Graphics' PathBuilder (the AppIcon renderer)
    mis-parses implicit repeated coordinate groups; explicit commands parse identically everywhere.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Tab bar -->
    <x:String x:Key="IconLogbook">M 4 19.5 V 6.5 A 2.5 2.5 0 0 1 6.5 4 H 19.5 V 17 H 6.5 A 2.5 2.5 0 0 0 4 19.5 A 2.5 2.5 0 0 0 6.5 22 H 19.5 V 17 M 8 8.5 h 7.5</x:String>
    <!-- "You" sliders — exact design path (S8 header + You rows) -->
    <x:String x:Key="IconYou">M 4 8 h 9 M 19 8 h 1 M 4 16 h 3 M 13 16 h 7 M 18.2 8 A 2.2 2.2 0 1 1 13.8 8 A 2.2 2.2 0 1 1 18.2 8 M 12.2 16 A 2.2 2.2 0 1 1 7.8 16 A 2.2 2.2 0 1 1 12.2 16</x:String>

    <!-- Sync radar (design's circular-arrow "radar" icon — sync button, sheet rows, spinner) -->
    <x:String x:Key="IconSync">M 20 12 a 8 8 0 1 1 -2.4 -5.7 M 18 3 v 4 h -4</x:String>

    <x:String x:Key="IconPlus">M 12 5 v 14 M 5 12 h 14</x:String>
    <x:String x:Key="IconGear">M 15.2 12 A 3.2 3.2 0 1 1 8.8 12 A 3.2 3.2 0 1 1 15.2 12 M 12 2.8 v 2.7 M 12 18.5 v 2.7 M 2.8 12 h 2.7 M 18.5 12 h 2.7 M 5.5 5.5 l 1.9 1.9 M 16.6 16.6 l 1.9 1.9 M 18.5 5.5 l -1.9 1.9 M 7.4 16.6 l -1.9 1.9</x:String>
    <!-- Pencil — exact design path (dive-detail notes row) -->
    <x:String x:Key="IconPencil">M 4 20 L 4.8 16.4 L 15.6 5.6 A 1.8 1.8 0 0 1 18.2 8.2 L 7.4 19 Z</x:String>
    <!-- Lock — exact design path (OAuth sheet browser chrome) -->
    <x:String x:Key="IconLock">M 7 10 h 10 a 2 2 0 0 1 2 2 v 5 a 2 2 0 0 1 -2 2 H 7 a 2 2 0 0 1 -2 -2 v -5 a 2 2 0 0 1 2 -2 Z M 8 10 V 7.5 a 4 4 0 0 1 8 0 V 10</x:String>
    <x:String x:Key="IconWarning">M 12 3.6 L 21.4 19.6 H 2.6 Z M 12 10.2 v 4 M 12 16.9 h 0.01</x:String>

    <x:String x:Key="IconBack">M 14.5 5.5 L 8 12 l 6.5 6.5</x:String>
    <x:String x:Key="IconChevron">M 9.5 5.5 L 16 12 l -6.5 6.5</x:String>
    <!-- Check — exact design path (paywall "Unlocked" confirmation) -->
    <x:String x:Key="IconCheck">M 5 13 L 10 18 L 19 6</x:String>

    <!-- Trend line — exact design path (empty-logbook stats glyph) -->
    <x:String x:Key="IconTrend">M 3 18 L 9 11 l 4 4 L 21 6</x:String>
    <!-- Biometric fingerprint — exact design path (auth hero button) -->
    <x:String x:Key="IconFingerprint">M 12 4.5 c -3 0 -5.5 2.4 -5.5 5.4 c 0 2.2 0.4 4.4 1.3 6.4 M 12 4.5 c 3 0 5.5 2.4 5.5 5.4 c 0 1.4 -0.1 2.8 -0.4 4.1 M 12 7.3 c -1.5 0 -2.7 1.2 -2.7 2.6 c 0 2.6 0.6 5.1 1.8 7.4 M 12 7.3 c 1.5 0 2.7 1.2 2.7 2.6 c 0 2.9 -0.7 5.7 -2 8.2 M 12 10 c 0 3 -0.7 5.9 -2 8.5</x:String>

</ResourceDictionary>
