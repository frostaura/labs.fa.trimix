<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dev-only console harness for reverse-engineering / validating cloud connectors against real
       vendor endpoints. NOT shipped: it exists so a connector's login → token → list → fetch flow can be
       iterated in seconds without a MAUI deploy cycle. Once a flow is proven here it is folded into
       Trimix.Core (see docs/architecture/overview.md — connector seam). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Trimix.Harness</RootNamespace>
    <UserSecretsId>fa.trimix.harness</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\app\Trimix.Core\Trimix.Core.csproj" />
  </ItemGroup>

</Project>
